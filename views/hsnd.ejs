<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hồ Sơ & Quản Lý Người Dùng - Climate Smart City</title>
    
    <!-- CSS Libraries -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Common CSS -->
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/loading.css">

    <!-- Page Specific CSS -->
    <style>
        /* Profile Cards */
        .profile-card {
            background: rgba(15, 23, 42, 0.65);
            border: 1px solid rgba(59, 130, 246, 0.35);
            border-radius: 20px;
            padding: 28px;
            margin-bottom: 28px;
            backdrop-filter: blur(16px);
            transition: transform 0.3s ease;
        }
        .profile-card:hover {
            transform: translateY(-4px);
        }

        .card-title {
            font-size: 1.35rem;
            font-weight: 700;
            color: #f8fafc;
            margin-bottom: 24px;
            padding-bottom: 12px;
            border-bottom: 2px solid var(--primary);
            display: inline-flex;
            align-items: center;
            gap: 12px;
        }

        .form-label {
            color: #cbd5e1;
            font-weight: 600;
            margin-bottom: 10px;
            font-size: 0.9rem;
        }

        .form-control, .form-select {
            background: rgba(30, 41, 59, 0.85);
            border: 1px solid rgba(59, 130, 246, 0.45);
            color: #f8fafc;
            border-radius: 12px;
            padding: 12px 16px;
            transition: all 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            background: rgba(30, 41, 59, 0.95);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.25);
        }

        /* Table */
        .table {
            background: rgba(15, 23, 42, 0.6);
            color: #f8fafc;
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 0;
        }

        .table thead {
            background: linear-gradient(90deg, var(--primary), var(--secondary));
        }

        .table th, .table td {
            border-color: rgba(59, 130, 246, 0.3);
            vertical-align: middle;
            padding: 12px 16px;
        }

        .table tbody tr:hover {
            background: rgba(59, 130, 246, 0.15);
        }

        .badge-admin {
            background: rgba(59, 130, 246, 0.25);
            color: #60a5fa;
            border: 1px solid #3b82f6;
            padding: 6px 14px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.8rem;
        }

        .badge-user {
            background: rgba(148, 163, 184, 0.25);
            color: #94a3b8;
            border: 1px solid #94a3b8;
            padding: 6px 14px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.8rem;
        }

        .btn-primary-custom {
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            border: none;
            padding: 12px 28px;
            border-radius: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-primary-custom:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.4);
        }

        .restricted-access {
            text-align: center;
            padding: 60px 40px;
            background: rgba(15, 23, 42, 0.6);
            border: 2px dashed rgba(59, 130, 246, 0.4);
            border-radius: 24px;
        }

        .restricted-icon {
            font-size: 4rem;
            color: #475569;
            margin-bottom: 20px;
        }

        @media (max-width: 768px) {
            .profile-card {
                padding: 20px;
            }
            .card-title {
                font-size: 1.2rem;
            }
            .table th, .table td {
                padding: 8px 12px;
                font-size: 0.85rem;
            }
        }
    </style>
</head>
<body>

    <!-- Header + Sidebar -->
    <% 
        let currentPage = 'hsnd';
        let user = locals.user;
    %>
    <%- include('partials/header') %>

    <!-- Main content -->
    <main class="main-content">
        <div class="page-header animate__animated animate__fadeIn">
            <h1 class="page-title"><i class="fas fa-user-cog me-3"></i> Hồ Sơ & Quản Lý Người Dùng</h1>
            <p class="lead text-center text-muted">Quản lý thông tin tài khoản và phân quyền người dùng</p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger animate__animated animate__shakeX alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i><%= error %>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success animate__animated animate__bounceIn alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i><%= success %>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (user && user.role === 'admin') { %>

            <!-- Form cập nhật vai trò -->
            <div class="profile-card animate__animated animate__fadeInUp">
                <h4 class="card-title"><i class="fas fa-user-shield" style="color: var(--primary);"></i> Cập Nhật Vai Trò Người Dùng</h4>
                <form action="/hsnd/update-role" method="POST">
                    <div class="row g-4">
                        <div class="col-md-5">
                            <label class="form-label">Chọn người dùng</label>
                            <select class="form-select" name="selectedUser" required>
                                <option value="" disabled selected>--- Chọn người dùng ---</option>
                                <% if (users && users.length > 0) { %>
                                    <% users.forEach(u => { %>
                                        <option value="<%= u.username %>">
                                            <%= u.username %> <%= u.username === user.username ? '(Bạn)' : '' %>
                                        </option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Vai trò mới</label>
                            <select class="form-select" name="newRole" required>
                                <option value="user">Người dùng thường</option>
                                <option value="admin">Quản trị viên</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary-custom w-100">
                                <i class="fas fa-sync-alt me-2"></i>Cập Nhật Vai Trò
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Danh sách người dùng -->
            <div class="profile-card animate__animated animate__fadeInUp">
                <h4 class="card-title"><i class="fas fa-users" style="color: var(--primary);"></i> Danh Sách Người Dùng Hệ Thống</h4>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th><i class="fas fa-user me-2"></i>Tên người dùng</th>
                                <th><i class="fas fa-envelope me-2"></i>Email</th>
                                <th><i class="fas fa-shield-alt me-2"></i>Vai trò</th>
                                <th><i class="fas fa-calendar-alt me-2"></i>Ngày đăng ký</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (users && users.length > 0) { %>
                                <% users.forEach(u => { %>
                                    <tr>
                                        <td>
                                            <strong><%= u.username %></strong>
                                            <% if (u.username === user.username) { %>
                                                <span class="badge bg-info ms-2" style="font-size: 0.7rem;">Bạn</span>
                                            <% } %>
                                        </td>
                                        <td><%= u.email || 'Chưa cung cấp' %></td>
                                        <td>
                                            <span class="<%= u.role === 'admin' ? 'badge-admin' : 'badge-user' %>">
                                                <%= u.role === 'admin' ? 'Quản trị viên' : 'Người dùng thường' %>
                                            </span>
                                        </td>
                                        <td>
                                            <%= u.created_at ? new Date(u.created_at).toLocaleDateString('vi-VN', { 
                                                year: 'numeric', month: '2-digit', day: '2-digit' 
                                            }) : 'N/A' %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                        Chưa có người dùng nào trong hệ thống
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        <% } else { %>
            <!-- Phần cho người dùng thường -->
            <div class="restricted-access animate__animated animate__fadeInUp">
                <div class="restricted-icon"><i class="fas fa-lock"></i></div>
                <h4 class="text-muted mb-3">Truy cập bị hạn chế</h4>
                <p class="text-muted mb-4" style="max-width: 420px; margin: 0 auto;">
                    Bạn không có quyền quản lý người dùng.<br>
                    Chỉ <strong style="color: var(--primary);">Quản trị viên</strong> mới có thể truy cập trang này.
                </p>
                <a href="/dashboard" class="btn btn-primary-custom px-5 mt-2">
                    <i class="fas fa-arrow-left me-2"></i>Quay về Dashboard
                </a>
            </div>
        <% } %>
    </main>

    <!-- Footer + Scripts -->
    <%- include('partials/footer') %>

    <!-- Page Specific Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Tự động ẩn alert sau 5 giây
            setTimeout(() => {
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(alert => {
                    const bsAlert = new bootstrap.Alert(alert);
                    setTimeout(() => bsAlert.close(), 500);
                });
            }, 5000);
        });
    </script>
</body>
</html>