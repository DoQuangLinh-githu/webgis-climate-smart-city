<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đổi Mật Khẩu - Climate Smart City</title>
    
    <!-- CSS Libraries -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Common CSS -->
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/loading.css">

    <!-- Page Specific CSS -->
    <style>
        .field-card {
            background: rgba(15, 23, 42, 0.65);
            border: 1px solid rgba(59, 130, 246, 0.35);
            border-radius: 20px;
            padding: 35px;
            backdrop-filter: blur(16px);
            box-shadow: 0 8px 32px rgba(0,0,0,0.2);
            transition: all 0.4s ease;
        }

        .field-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 40px rgba(59, 130, 246, 0.25);
        }

        .field-header {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 18px 24px;
            border-radius: 16px 16px 0 0;
            margin: -35px -35px 30px -35px;
            font-weight: 700;
        }

        .field-header h5 {
            margin: 0;
            font-size: 1.2rem;
        }

        /* CUSTOM INPUT GROUP - FIX LỖI ĐÈ CHỮ */
        .custom-input-group {
            margin-bottom: 25px;
        }

        .custom-input-group label {
            display: block;
            margin-bottom: 8px;
            color: #94a3b8;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .custom-input-group label i {
            margin-right: 8px;
            color: #60a5fa;
        }

        .password-container {
            position: relative;
            display: flex;
            align-items: center;
        }

        .password-container input {
            width: 100%;
            background: rgba(30, 41, 59, 0.9);
            border: 1.5px solid rgba(59, 130, 246, 0.3);
            color: #f8fafc;
            border-radius: 14px;
            padding: 14px 50px 14px 18px;
            font-size: 1rem;
            transition: all 0.2s;
        }

        .password-container input:focus {
            background: rgba(30, 41, 59, 1);
            border-color: #3b82f6;
            outline: none;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
        }

        .toggle-password-btn {
            position: absolute;
            right: 15px;
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            font-size: 1.1rem;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .toggle-password-btn:hover {
            color: #60a5fa;
        }

        .form-text {
            color: #94a3b8 !important;
            font-size: 0.75rem;
            margin-top: 6px;
        }

        .btn-primary-custom {
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            border: none;
            border-radius: 50px;
            padding: 14px 50px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            color: white;
        }

        .btn-primary-custom:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(59, 130, 246, 0.5);
            color: white;
        }

        .btn-outline-light-custom {
            background: transparent;
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 50px;
            padding: 14px 35px;
            color: #cbd5e1;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

        .btn-outline-light-custom:hover {
            background: rgba(255,255,255,0.1);
            color: white;
            text-decoration: none;
        }

        .restricted-access {
            text-align: center;
            padding: 60px 40px;
            background: rgba(15, 23, 42, 0.6);
            border: 2px dashed rgba(59, 130, 246, 0.4);
            border-radius: 24px;
        }

        .restricted-icon {
            font-size: 4rem;
            color: #475569;
            margin-bottom: 20px;
        }

        .alert {
            border-radius: 16px;
            margin-bottom: 25px;
        }

        @media (max-width: 768px) {
            .field-card {
                padding: 25px;
            }
            .field-header {
                margin: -25px -25px 25px -25px;
            }
            .btn-primary-custom {
                padding: 12px 35px;
            }
            .btn-outline-light-custom {
                padding: 12px 25px;
                margin-top: 10px;
            }
            .text-center-mobile {
                text-align: center;
            }
        }
    </style>
</head>
<body>

    <!-- Header + Sidebar -->
    <% 
        let currentPage = 'doimatkhau';
        let user = locals.user;
    %>
    <%- include('partials/header') %>

    <!-- Main content -->
    <main class="main-content">
        <div class="page-header animate__animated animate__fadeIn">
            <h1 class="page-title"><i class="fas fa-key me-3"></i> Đổi Mật Khẩu</h1>
            <p class="lead text-center text-muted">Bảo mật tài khoản của bạn với mật khẩu mới</p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger animate__animated animate__shakeX alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i><%= error %>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success animate__animated animate__bounceIn alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i><%= success %>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (!user) { %>
            <div class="restricted-access animate__animated animate__fadeInUp">
                <div class="restricted-icon"><i class="fas fa-lock"></i></div>
                <h4 class="text-muted mb-3">Vui lòng đăng nhập</h4>
                <p class="text-muted mb-4">Bạn cần đăng nhập để thay đổi mật khẩu.</p>
                <a href="/login" class="btn btn-primary-custom px-5">
                    <i class="fas fa-sign-in-alt me-2"></i>Đăng Nhập Ngay
                </a>
            </div>
        <% } else { %>
            <div class="field-card animate__animated animate__fadeInUp">
                <div class="field-header">
                    <h5><i class="fas fa-shield-alt me-2"></i> Thay đổi mật khẩu tài khoản</h5>
                    <p class="mb-0 small" style="opacity: 0.8;">Xin chào, <strong><%= user.username || user.email || 'Người dùng' %></strong></p>
                </div>
                
                <form action="/doimatkhau" method="POST" id="changePasswordForm">
                    <!-- Mật khẩu cũ -->
                    <div class="custom-input-group">
                        <label><i class="fas fa-lock"></i> Mật khẩu cũ</label>
                        <div class="password-container">
                            <input type="password" id="oldPassword" name="oldPassword" placeholder="Nhập mật khẩu hiện tại" required>
                            <button type="button" class="toggle-password-btn" data-target="oldPassword">
                                <i class="fas fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Mật khẩu mới -->
                    <div class="custom-input-group">
                        <label><i class="fas fa-key"></i> Mật khẩu mới</label>
                        <div class="password-container">
                            <input type="password" id="newPassword" name="newPassword" placeholder="Nhập mật khẩu mới" required>
                            <button type="button" class="toggle-password-btn" data-target="newPassword">
                                <i class="fas fa-eye-slash"></i>
                            </button>
                        </div>
                        <div class="form-text">
                            <i class="fas fa-info-circle me-1"></i> Mật khẩu phải có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt (@, $, !, %, *, ?, &, #)
                        </div>
                    </div>

                    <!-- Xác nhận mật khẩu mới -->
                    <div class="custom-input-group">
                        <label><i class="fas fa-check-circle"></i> Xác nhận mật khẩu mới</label>
                        <div class="password-container">
                            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Nhập lại mật khẩu mới" required>
                            <button type="button" class="toggle-password-btn" data-target="confirmPassword">
                                <i class="fas fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary-custom" id="submitBtn">
                            <i class="fas fa-save me-2"></i>Đổi Mật Khẩu
                        </button>
                        <a href="/dashboard" class="btn-outline-light-custom ms-3">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </a>
                    </div>
                </form>
            </div>
        <% } %>
    </main>

    <!-- Footer + Scripts -->
    <%- include('partials/footer') %>

    <!-- Page Specific Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('changePasswordForm');
            const newPassword = document.getElementById('newPassword');
            const confirmPassword = document.getElementById('confirmPassword');
            const oldPassword = document.getElementById('oldPassword');

            // ========== TOGGLE PASSWORD VISIBILITY ==========
            const toggleButtons = document.querySelectorAll('.toggle-password-btn');
            
            toggleButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const targetId = this.getAttribute('data-target');
                    const input = document.getElementById(targetId);
                    const icon = this.querySelector('i');
                    
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.remove('fa-eye-slash');
                        icon.classList.add('fa-eye');
                    } else {
                        input.type = 'password';
                        icon.classList.remove('fa-eye');
                        icon.classList.add('fa-eye-slash');
                    }
                });
            });

            // ========== VALIDATION FUNCTIONS ==========
            // Validate password match
            function validatePasswordMatch() {
                if (newPassword.value !== confirmPassword.value) {
                    confirmPassword.setCustomValidity('Mật khẩu xác nhận không khớp');
                    return false;
                } else {
                    confirmPassword.setCustomValidity('');
                    return true;
                }
            }

            // Validate password strength
            function validatePasswordStrength(password) {
                const minLength = password.length >= 8;
                const hasUpperCase = /[A-Z]/.test(password);
                const hasLowerCase = /[a-z]/.test(password);
                const hasNumbers = /\d/.test(password);
                const hasSpecialChar = /[@$!%*?&#]/.test(password);
                
                if (password.length === 0) return true; // chưa nhập thì chưa báo lỗi
                return minLength && hasUpperCase && hasLowerCase && hasNumbers && hasSpecialChar;
            }

            // Hiển thị thông báo lỗi strength
            newPassword.addEventListener('input', function() {
                const isValid = validatePasswordStrength(this.value);
                if (!isValid && this.value.length > 0) {
                    this.setCustomValidity('Mật khẩu phải có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt');
                } else {
                    this.setCustomValidity('');
                }
                validatePasswordMatch();
            });

            // Kiểm tra mật khẩu mới không được trùng mật khẩu cũ
            newPassword.addEventListener('input', function() {
                if (oldPassword.value && this.value === oldPassword.value) {
                    this.setCustomValidity('Mật khẩu mới không được trùng với mật khẩu cũ');
                } else if (this.value.length > 0 && validatePasswordStrength(this.value)) {
                    this.setCustomValidity('');
                }
            });

            confirmPassword.addEventListener('input', validatePasswordMatch);

            // Auto hide alerts after 5 seconds
            setTimeout(() => {
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(alert => {
                    const bsAlert = new bootstrap.Alert(alert);
                    setTimeout(() => bsAlert.close(), 500);
                });
            }, 5000);

            // Ngăn submit nếu form không hợp lệ
            if (form) {
                form.addEventListener('submit', function(e) {
                    if (newPassword.value !== confirmPassword.value) {
                        e.preventDefault();
                        alert('Mật khẩu xác nhận không khớp!');
                    }
                    if (newPassword.value === oldPassword.value) {
                        e.preventDefault();
                        alert('Mật khẩu mới không được trùng với mật khẩu cũ!');
                    }
                    if (!validatePasswordStrength(newPassword.value) && newPassword.value.length > 0) {
                        e.preventDefault();
                        alert('Mật khẩu mới không đủ mạnh! Vui lòng nhập ít nhất 8 ký tự bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt.');
                    }
                });
            }
        });
    </script>
</body>
</html>