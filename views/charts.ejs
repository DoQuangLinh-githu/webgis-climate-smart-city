<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đồ Thị Đánh Giá Climate Smart City | TP.HCM</title>
    
    <!-- CSS Libraries -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Common CSS -->
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/loading.css">

    <style>
        :root {
            --primary: #3b82f6;
            --secondary: #8b5cf6;
            --success: #10b981;
            --info: #06b6d4;
            --warning: #f59e0b;
            --danger: #ef4444;
            --dark: #0f172a;
            --gray: #94a3b8;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: #f8fafc;
            min-height: 100vh;
        }

        .main-content {
            margin-left: 280px;
            padding: 30px;
            min-height: 100vh;
            transition: margin-left 0.3s ease;
        }

        @media (max-width: 992px) {
            .main-content {
                margin-left: 0;
                padding: 80px 20px 30px 20px;
            }
        }

        .page-header {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(139, 92, 246, 0.1));
            border: 1px solid rgba(59, 130, 246, 0.4);
            border-radius: 28px;
            padding: 35px;
            margin-bottom: 35px;
            backdrop-filter: blur(12px);
            position: relative;
            overflow: hidden;
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
        }

        .page-title {
            font-size: 2.2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #ffffff, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 12px;
        }

        .chart-card {
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 24px;
            padding: 24px;
            margin-bottom: 30px;
            backdrop-filter: blur(12px);
            transition: all 0.3s ease;
        }

        .chart-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            border-color: rgba(59, 130, 246, 0.6);
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 15px;
            border-bottom: 1px solid rgba(59, 130, 246, 0.2);
            padding-bottom: 15px;
        }

        .chart-header h3 {
            font-size: 1.3rem;
            font-weight: 700;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .chart-header h3 i {
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 10px;
            font-size: 1rem;
        }

        .chart-container {
            position: relative;
            height: 420px;
            width: 100%;
        }

        .chart-container-sm {
            height: 380px;
        }

        .control-bar {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 30px;
            backdrop-filter: blur(12px);
        }

        .form-label {
            color: #cbd5e1;
            font-weight: 600;
            font-size: 0.85rem;
            margin-bottom: 8px;
        }

        .form-select, .form-control {
            background: rgba(30, 41, 59, 0.9);
            border: 1.5px solid rgba(59, 130, 246, 0.3);
            color: #f8fafc;
            border-radius: 12px;
            padding: 10px 16px;
            font-size: 0.9rem;
        }

        .form-select:focus, .form-control:focus {
            background: rgba(30, 41, 59, 1);
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        }

        .btn-download {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
            border-radius: 50px;
            padding: 8px 20px;
            font-weight: 600;
            color: white;
            transition: all 0.3s;
        }

        .btn-download:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(59, 130, 246, 0.4);
        }

        .stats-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-box {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 20px;
            padding: 20px;
            text-align: center;
            transition: all 0.3s;
        }

        .stat-box:hover {
            transform: translateY(-3px);
            background: rgba(59, 130, 246, 0.1);
        }

        .stat-box .value {
            font-size: 2rem;
            font-weight: 800;
            color: var(--primary);
        }

        .stat-box .label {
            color: #94a3b8;
            font-size: 0.85rem;
            margin-top: 5px;
        }

        @media (max-width: 768px) {
            .chart-container { height: 300px; }
            .chart-container-sm { height: 280px; }
            .page-header { padding: 25px; }
            .page-title { font-size: 1.6rem; }
        }

        .legend {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 15px;
            justify-content: center;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.8rem;
        }

        .legend-color {
            width: 20px;
            height: 20px;
            border-radius: 4px;
        }

        .loading-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(12px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 10000;
        }

        .loading-overlay.show { display: flex; }

        .loading-spinner {
            width: 50px;
            height: 50px;
            border: 3px solid rgba(59, 130, 246, 0.3);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 15px;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>

    <% let currentPage = 'charts'; let user = locals.user; %>
    <%- include('partials/header') %>

    <div class="loading-overlay" id="loadingOverlay">
        <div class="text-center">
            <div class="loading-spinner mx-auto"></div>
            <h5 class="text-white">Đang tải dữ liệu...</h5>
        </div>
    </div>

    <main class="main-content">
        <div class="page-header animate__animated animate__fadeIn">
            <h1 class="page-title"><i class="fas fa-chart-pie me-3"></i> Đồ Thị Đánh Giá Climate Smart City</h1>
            <p class="lead text-muted mb-0">Trực quan hóa dữ liệu 5 lĩnh vực và các chỉ số đánh giá</p>
        </div>

        <!-- Thống kê nhanh -->
        <div class="stats-summary animate__animated animate__fadeInUp">
            <div class="stat-box">
                <div class="value"><%= assessments ? assessments.length : 0 %></div>
                <div class="label">Tổng chỉ số đánh giá</div>
            </div>
            <div class="stat-box">
                <div class="value">5</div>
                <div class="label">Lĩnh vực đánh giá</div>
            </div>
            <div class="stat-box">
                <div class="value"><% 
                    let total = 0;
                    let countValid = 0;
                    for(let i = 1; i <= 5; i++) {
                        let score = domainScores[i] || 0;
                        if(score > 0) {
                            total += score;
                            countValid++;
                        }
                    }
                    let avg = countValid > 0 ? (total / countValid).toFixed(1) : '0';
                %><%= avg %>%</div>
                <div class="label">Điểm trung bình</div>
            </div>
            <div class="stat-box">
                <div class="value"><%
                    let bestScore = 0;
                    let bestName = 'Chưa có dữ liệu';
                    const domainNamesStat = ['', 'Năng Lượng', 'Quy Hoạch', 'Giao Thông', 'Quản Lý Nước', 'Quản Lý Chất Thải'];
                    for(let i = 1; i <= 5; i++) {
                        let score = domainScores[i] || 0;
                        if(score > bestScore) {
                            bestScore = score;
                            bestName = domainNamesStat[i];
                        }
                    }
                    if(bestScore === 0) bestName = 'Chưa có dữ liệu';
                %><%= bestName %></div>
                <div class="label">Lĩnh vực tốt nhất</div>
            </div>
        </div>

        <!-- Điều khiển -->
        <div class="control-bar animate__animated animate__fadeInUp">
            <div class="row align-items-end g-3">
                <div class="col-md-4">
                    <label class="form-label"><i class="fas fa-calendar me-1"></i> Năm đánh giá</label>
                    <select id="yearSelect" class="form-select">
                        <% if (years && years.length > 0) { %>
                            <% years.forEach(y => { %>
                                <option value="<%= y %>" <%= String(y) === String(selectedYear) ? 'selected' : '' %>><%= y %></option>
                            <% }) %>
                        <% } else { %>
                            <option value="2024">2024</option>
                            <option value="2025" selected>2025</option>
                            <option value="2026">2026</option>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="fas fa-chart-simple me-1"></i> Loại biểu đồ</label>
                    <select id="chartTypeSelect" class="form-select">
                        <option value="radar">Biểu đồ Radar (5 lĩnh vực)</option>
                        <option value="bar">Biểu đồ Cột (tiêu chí từng lĩnh vực)</option>
                        <option value="line">Biểu đồ Đường (các chỉ số)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-2">
                        <button id="refreshBtn" class="btn-download w-100">
                            <i class="fas fa-sync-alt me-2"></i>Cập nhật
                        </button>
                        <button id="downloadBtn" class="btn-download">
                            <i class="fas fa-download me-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- BIỂU ĐỒ RADAR - 5 LĨNH VỰC -->
        <div id="radarChartCard" class="chart-card">
            <div class="chart-header">
                <h3><i class="fas fa-chart-pie"></i> Biểu đồ Radar - 5 Lĩnh vực đánh giá</h3>
                <div class="legend">
                    <div class="legend-item"><div class="legend-color" style="background: #3b82f6;"></div><span>Điểm đánh giá</span></div>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="radarChart"></canvas>
            </div>
        </div>

        <!-- BIỂU ĐỒ CỘT -->
        <div id="barChartCard" class="chart-card" style="display: none;">
            <div class="chart-header">
                <h3><i class="fas fa-chart-bar"></i> Biểu đồ Cột - Chi tiết tiêu chí từng lĩnh vực</h3>
                <div class="d-flex gap-2">
                    <select id="domainSelect" class="form-select" style="width: 220px;">
                        <option value="1">⚡ Lĩnh vực 1: Năng lượng</option>
                        <option value="2">🏙️ Lĩnh vực 2: Quy hoạch</option>
                        <option value="3">🚌 Lĩnh vực 3: Giao thông</option>
                        <option value="4">💧 Lĩnh vực 4: Quản lý nước</option>
                        <option value="5">♻️ Lĩnh vực 5: Chất thải</option>
                    </select>
                </div>
            </div>
            <div class="chart-container-sm">
                <canvas id="barChart"></canvas>
            </div>
        </div>

        <!-- BIỂU ĐỒ ĐƯỜNG -->
        <div id="lineChartCard" class="chart-card" style="display: none;">
            <div class="chart-header">
                <h3><i class="fas fa-chart-line"></i> Biểu đồ Đường - Các chỉ số đánh giá</h3>
                <div class="d-flex gap-2">
                    <select id="lineDomainSelect" class="form-select" style="width: 220px;">
                        <option value="all">📊 Tất cả lĩnh vực</option>
                        <option value="1">⚡ Lĩnh vực 1: Năng lượng</option>
                        <option value="2">🏙️ Lĩnh vực 2: Quy hoạch</option>
                        <option value="3">🚌 Lĩnh vực 3: Giao thông</option>
                        <option value="4">💧 Lĩnh vực 4: Quản lý nước</option>
                        <option value="5">♻️ Lĩnh vực 5: Chất thải</option>
                    </select>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="lineChart"></canvas>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // DỮ LIỆU TỪ SERVER
        const domainScoresData = {
            1: <%= domainScores[1] || 0 %>,
            2: <%= domainScores[2] || 0 %>,
            3: <%= domainScores[3] || 0 %>,
            4: <%= domainScores[4] || 0 %>,
            5: <%= domainScores[5] || 0 %>
        };
        
        const assessmentsData = <%- JSON.stringify(assessments || []) %>;
        
        // Debug
        console.log('Domain Scores:', domainScoresData);
        console.log('Assessments count:', assessmentsData.length);
        
        const domainNames = {
            1: 'Năng lượng', 2: 'Quy hoạch', 3: 'Giao thông', 4: 'Quản lý nước', 5: 'Chất thải'
        };

        let radarChart, barChart, lineChart;

        function showLoading() { 
            const overlay = document.getElementById('loadingOverlay');
            if (overlay) overlay.classList.add('show'); 
        }
        
        function hideLoading() { 
            const overlay = document.getElementById('loadingOverlay');
            if (overlay) overlay.classList.remove('show'); 
        }

        // Cập nhật biểu đồ Radar
        function updateRadarChart() {
            const canvas = document.getElementById('radarChart');
            if (!canvas) return;
            if (radarChart) radarChart.destroy();
            
            const scores = [];
            const labels = [];
            for (let i = 1; i <= 5; i++) {
                labels.push(domainNames[i]);
                scores.push(domainScoresData[i] || 0);
            }
            
            const ctx = canvas.getContext('2d');
            radarChart = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Điểm đánh giá',
                        data: scores,
                        backgroundColor: 'rgba(59, 130, 246, 0.2)',
                        borderColor: '#3b82f6',
                        borderWidth: 3,
                        pointBackgroundColor: '#8b5cf6',
                        pointBorderColor: '#fff',
                        pointRadius: 5,
                        pointHoverRadius: 8,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            beginAtZero: true,
                            max: 100,
                            ticks: { color: '#94a3b8', stepSize: 20 },
                            grid: { color: 'rgba(148, 163, 184, 0.2)' },
                            angleLines: { color: 'rgba(148, 163, 184, 0.2)' },
                            pointLabels: { color: '#cbd5e1', font: { size: 12, weight: 'bold' } }
                        }
                    },
                    plugins: {
                        legend: { labels: { color: '#f8fafc' } },
                        tooltip: { backgroundColor: '#1e293b', titleColor: '#f8fafc', bodyColor: '#94a3b8' }
                    }
                }
            });
        }
        
        // Cập nhật biểu đồ cột
        function updateBarChart() {
            const canvas = document.getElementById('barChart');
            if (!canvas) return;
            
            const domainId = parseInt(document.getElementById('domainSelect')?.value || 1);
            const indicators = assessmentsData.filter(ind => ind.domain_id === domainId);
            
            if (barChart) barChart.destroy();
            if (indicators.length === 0) return;
            
            const labels = indicators.map((_, i) => `CS${i + 1}`);
            const scores = indicators.map(ind => ind.score_awarded || 0);
            
            const ctx = canvas.getContext('2d');
            barChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: `${domainNames[domainId]} - Điểm các chỉ số`,
                        data: scores,
                        backgroundColor: 'rgba(59, 130, 246, 0.7)',
                        borderColor: '#3b82f6',
                        borderWidth: 1,
                        borderRadius: 6,
                        hoverBackgroundColor: 'rgba(139, 92, 246, 0.8)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, max: 100, ticks: { color: '#94a3b8' }, grid: { color: 'rgba(148, 163, 184, 0.1)' } },
                        x: { ticks: { color: '#94a3b8', rotation: 45, maxRotation: 90, font: { size: 10 } }, grid: { display: false } }
                    },
                    plugins: {
                        legend: { labels: { color: '#f8fafc' } },
                        tooltip: { backgroundColor: '#1e293b', titleColor: '#f8fafc', bodyColor: '#94a3b8' }
                    }
                }
            });
        }
        
        // Cập nhật biểu đồ đường
        function updateLineChart() {
            const canvas = document.getElementById('lineChart');
            if (!canvas) return;
            
            const domainFilter = document.getElementById('lineDomainSelect')?.value || 'all';
            let indicators = [];
            let title = '';
            
            if (domainFilter === 'all') {
                indicators = assessmentsData;
                title = `Tất cả các chỉ số (${indicators.length} chỉ số)`;
            } else {
                const domainId = parseInt(domainFilter);
                indicators = assessmentsData.filter(ind => ind.domain_id === domainId);
                title = `${domainNames[domainId]} - ${indicators.length} chỉ số`;
            }
            
            if (lineChart) lineChart.destroy();
            if (indicators.length === 0) return;
            
            const labels = indicators.map((_, i) => `${i + 1}`);
            const scores = indicators.map(ind => ind.score_awarded || 0);
            
            const ctx = canvas.getContext('2d');
            lineChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: title,
                        data: scores,
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.3,
                        pointRadius: 3,
                        pointBackgroundColor: '#8b5cf6',
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, max: 100, ticks: { color: '#94a3b8' }, grid: { color: 'rgba(148, 163, 184, 0.1)' } },
                        x: { ticks: { color: '#94a3b8', autoSkip: true, maxTicksLimit: 20 }, grid: { display: false } }
                    },
                    plugins: {
                        legend: { labels: { color: '#f8fafc' } },
                        tooltip: { backgroundColor: '#1e293b', titleColor: '#f8fafc', bodyColor: '#94a3b8' }
                    }
                }
            });
        }
        
        function switchChartType(type) {
            const radarCard = document.getElementById('radarChartCard');
            const barCard = document.getElementById('barChartCard');
            const lineCard = document.getElementById('lineChartCard');
            
            if (radarCard) radarCard.style.display = 'none';
            if (barCard) barCard.style.display = 'none';
            if (lineCard) lineCard.style.display = 'none';
            
            if (type === 'radar') {
                if (radarCard) radarCard.style.display = 'block';
                updateRadarChart();
            } else if (type === 'bar') {
                if (barCard) barCard.style.display = 'block';
                setTimeout(updateBarChart, 100);
            } else if (type === 'line') {
                if (lineCard) lineCard.style.display = 'block';
                setTimeout(updateLineChart, 100);
            }
        }
        
        function downloadCurrentChart() {
            const type = document.getElementById('chartTypeSelect')?.value || 'radar';
            let canvas;
            if (type === 'radar') canvas = document.getElementById('radarChart');
            else if (type === 'bar') canvas = document.getElementById('barChart');
            else canvas = document.getElementById('lineChart');
            
            if (canvas) {
                const link = document.createElement('a');
                link.download = `chart_${type}_${new Date().toISOString().slice(0, 19)}.png`;
                link.href = canvas.toBase64Image();
                link.click();
            }
        }
        
        // Khởi tạo
        document.addEventListener('DOMContentLoaded', () => {
            updateRadarChart();
            
            const refreshBtn = document.getElementById('refreshBtn');
            if (refreshBtn) {
                refreshBtn.addEventListener('click', () => {
                    const year = document.getElementById('yearSelect')?.value || '2025';
                    window.location.href = `/charts?year=${year}`;
                });
            }
            
            const downloadBtn = document.getElementById('downloadBtn');
            if (downloadBtn) {
                downloadBtn.addEventListener('click', downloadCurrentChart);
            }
            
            const chartTypeSelect = document.getElementById('chartTypeSelect');
            if (chartTypeSelect) {
                chartTypeSelect.addEventListener('change', (e) => {
                    switchChartType(e.target.value);
                });
            }
            
            const domainSelect = document.getElementById('domainSelect');
            if (domainSelect) {
                domainSelect.addEventListener('change', updateBarChart);
            }
            
            const lineDomainSelect = document.getElementById('lineDomainSelect');
            if (lineDomainSelect) {
                lineDomainSelect.addEventListener('change', updateLineChart);
            }
        });
    </script>
</body>
</html>