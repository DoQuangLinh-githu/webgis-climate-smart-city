<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cập Nhật Dữ Liệu - Climate Smart City</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/loading.css">

    <style>
        /* ===== RESET & BASE ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: #f8fafc;
        }

        /* ===== ACCORDION ===== */
        .accordion-item {
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 16px;
            margin-bottom: 20px;
            overflow: hidden;
            backdrop-filter: blur(8px);
        }

        .accordion-button {
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            color: white !important;
            font-weight: 600;
            padding: 18px 24px;
            border-radius: 0 !important;
        }

        .accordion-button:not(.collapsed) {
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            color: white !important;
            box-shadow: none;
        }

        .accordion-button:focus {
            box-shadow: none;
            border-color: transparent;
        }

        .accordion-button::after {
            filter: brightness(0) invert(1);
        }

        .accordion-body {
            padding: 1.5rem;
        }

        /* ===== FIELD CARD ===== */
        .field-card {
            background: rgba(30, 41, 59, 0.95);
            border: 1px solid rgba(59, 130, 246, 0.35);
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 25px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .field-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(59, 130, 246, 0.2);
        }

        .field-header {
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            color: white !important;
            padding: 16px 24px;
            border-radius: 12px 12px 0 0;
            margin: -25px -25px 25px -25px;
        }

        .field-header h5 {
            color: white !important;
            margin: 0;
        }

        .field-header i {
            color: rgba(255,255,255,0.8);
        }

        /* ===== INDICATOR LIST (CHECKBOX) ===== */
        .indicator-list {
            background: rgba(30, 41, 59, 0.8) !important;
            border: 1px solid rgba(59, 130, 246, 0.3) !important;
            border-radius: 12px !important;
            padding: 1.5rem !important;
        }

        .indicator-list h5 {
            color: #60a5fa !important;
            margin-bottom: 1.25rem !important;
        }

        .indicator-list .form-check {
            margin-bottom: 0.75rem;
        }

        .indicator-list .form-check-label {
            color: #f8fafc !important;
            font-weight: 500 !important;
            cursor: pointer;
        }

        .indicator-list .form-check-label:hover {
            color: #60a5fa !important;
        }

        .indicator-list .form-check-input {
            background-color: rgba(30, 41, 59, 0.9) !important;
            border: 1.5px solid rgba(59, 130, 246, 0.5) !important;
            cursor: pointer;
        }

        .indicator-list .form-check-input:checked {
            background-color: #3b82f6 !important;
            border-color: #3b82f6 !important;
        }

        /* ===== FORM CONTROLS ===== */
        .form-control, .form-select {
            background: rgba(30, 41, 59, 0.9) !important;
            border: 1px solid rgba(59, 130, 246, 0.4) !important;
            color: #f8fafc !important;
            border-radius: 10px !important;
            padding: 12px 16px !important;
        }

        .form-control:focus, .form-select:focus {
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.25) !important;
            background: rgba(30, 41, 59, 1) !important;
        }

        .form-control::placeholder {
            color: #64748b !important;
        }

        .form-floating > label {
            color: #94a3b8 !important;
        }

        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: #60a5fa !important;
        }

        .form-select option {
            background-color: #1e293b !important;
            color: #f8fafc !important;
        }

        /* ===== BUTTONS ===== */
        .btn-primary {
            background: linear-gradient(90deg, #3b82f6, #8b5cf6) !important;
            border: none !important;
            border-radius: 50px !important;
            padding: 12px 28px !important;
            font-weight: 600 !important;
            color: white !important;
            transition: all 0.3s ease !important;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.5);
        }

        .btn-outline-info {
            border: 1.5px solid #60a5fa !important;
            color: #60a5fa !important;
            border-radius: 50px !important;
            padding: 10px 24px !important;
            background: transparent !important;
        }

        .btn-outline-info:hover {
            background: rgba(96, 165, 250, 0.15) !important;
            color: white !important;
        }

        /* ===== TABLE ===== */
        .table {
            color: #f8fafc !important;
            border-color: rgba(59, 130, 246, 0.3) !important;
        }

        .table-bordered td, .table-bordered th {
            border-color: rgba(59, 130, 246, 0.3) !important;
        }

        .table-primary th {
            background: linear-gradient(90deg, #3b82f6, #8b5cf6) !important;
            color: white !important;
        }

        /* ===== SOURCE EDIT ===== */
        .source-wrapper .source-text {
            color: #94a3b8 !important;
        }

        .source-wrapper .btn-edit-source {
            color: #f59e0b !important;
        }

        .source-wrapper textarea {
            background: rgba(30, 41, 59, 0.9) !important;
            border: 1px solid rgba(59, 130, 246, 0.4) !important;
            color: #f8fafc !important;
        }

        /* ===== CHART ===== */
        .chart-container {
            background: rgba(30, 41, 59, 0.5);
            border-radius: 12px;
            padding: 15px;
        }

        /* ===== ALERTS ===== */
        .alert-danger {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid #ef4444;
            color: #fca5a5;
        }

        .alert-success {
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid #10b981;
            color: #a7f3d0;
        }

        /* ===== VALIDATION ===== */
        .is-invalid {
            border-color: #dc3545 !important;
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            .field-card {
                padding: 20px;
            }
            .accordion-button {
                padding: 16px 20px;
                font-size: 1rem;
            }
            .indicator-list {
                padding: 1rem !important;
            }
        }
    </style>
</head>
<body>

    <% 
        let currentPage = 'cndl';
        let user = locals.user;
    %>
    <%- include('../partials/header') %>

    <main class="main-content">
        <div class="page-header">
            <h1 class="page-title"><i class="fas fa-edit me-3"></i> Cập Nhật Dữ Liệu</h1>
            <p class="lead text-center text-muted">Tính toán và cập nhật các chỉ số môi trường</p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i><%= error %></div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i><%= success %></div>
        <% } %>

        <div class="accordion" id="domainAccordion">
            <%- include('domain1') %>
            <%- include('domain2') %>
            <%- include('domain3') %>
            <%- include('domain4') %>
            <%- include('domain5') %>
        </div>
    </main>

    <!-- Preview Modal -->
    <%- include('shared/preview-modal') %>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/common.js"></script>
    <script src="/js/sidebar.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="/js/cndl/main.js"></script>
    
    <script>
        // Khởi tạo checkbox hiển thị indicator
        document.querySelectorAll('.indicator-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', function () {
                const indicatorId = this.id.replace('check_', '');
                const section = document.getElementById('section_' + indicatorId);
                if (section) {
                    section.style.display = this.checked ? 'block' : 'none';
                    // Nếu bỏ chọn, reset tất cả input trong section
                    if (!this.checked) {
                        section.querySelectorAll('input, select, textarea').forEach(input => {
                            input.value = '';
                        });
                    }
                }
            });
        });

        // Khởi tạo tooltips
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
            new bootstrap.Tooltip(el);
        });

        // Khởi tạo các collapse để accordion hoạt động
        var accordionButtons = document.querySelectorAll('.accordion-button');
        accordionButtons.forEach(button => {
            button.addEventListener('click', function() {
                const target = document.querySelector(this.getAttribute('data-bs-target'));
                if (target) {
                    target.classList.toggle('show');
                    this.classList.toggle('collapsed');
                }
            });
        });
    </script>
</body>
</html>