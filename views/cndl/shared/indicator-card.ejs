<!-- views/cndl/shared/indicator-card.ejs -->
<% 
    const { indicatorCode, indicatorName, description, required, inputs } = locals;
%>
<div class="indicator-section" id="section_<%= indicatorCode %>" style="display: none;" data-required="<%= required %>">
    <div class="field-card" style="background: rgba(30, 41, 59, 0.95); border: 1px solid rgba(59, 130, 246, 0.4); border-radius: 16px; padding: 25px; margin-bottom: 25px;">
        <div class="field-header" style="background: linear-gradient(90deg, #3b82f6, #8b5cf6); padding: 16px 24px; border-radius: 12px 12px 0 0; margin: -25px -25px 25px -25px;">
            <h5 style="color: white; margin: 0; display: inline-block;">
                <i class="fas fa-calculator me-2"></i>Chỉ số <%= indicatorCode %>: <%= indicatorName %>
            </h5>
            <i class="fas fa-info-circle tooltip-icon ms-2" style="color: rgba(255,255,255,0.8);" data-bs-toggle="tooltip" title="<%= description %>"></i>
        </div>
        <div class="card-body p-3">
            
            <% inputs.forEach((input, idx) => { %>
                <div class="row mb-4">
                    <div class="col-md-8">
                        <!-- Label thay vì form-floating -->
                        <label for="<%= input.id %>" class="form-label" style="color: #cbd5e1; font-weight: 500; margin-bottom: 8px;">
                            <%= input.label %>
                            <i class="fas fa-info-circle ms-1" style="color: #60a5fa;" data-bs-toggle="tooltip" title="<%= input.tooltip %>"></i>
                        </label>
                        <input type="text" 
                               id="<%= input.id %>" 
                               name="<%= indicatorCode %>[params][<%= input.param %>]"
                               class="form-control" 
                               step="any"
                               placeholder="Nhập giá trị"
                               style="background: rgba(30, 41, 59, 0.9); border: 1px solid rgba(59, 130, 246, 0.4); color: #f8fafc; border-radius: 10px; padding: 12px 16px; width: 100%;">
                        
                        <!-- Component sửa nguồn -->
                        <%- include('source-edit', { 
                            param: input.param, 
                            sourceText: input.sourceText, 
                            folderId: input.folderId 
                        }) %>
                    </div>
                    <div class="col-md-1 d-flex align-items-start justify-content-end" style="margin-top: 38px;">
                        <a href="<%= input.driveLink %>" target="_blank" title="Xem tài liệu hỗ trợ" style="color: #60a5fa; text-decoration: none;">
                            <i class="fas fa-paperclip fa-lg"></i>
                        </a>
                    </div>
                    <div class="col-md-3"></div>
                </div>
            <% }) %>

            <div class="mt-4 d-flex gap-3">
                <button type="button" class="btn btn-primary preview-btn" data-indicator="<%= indicatorCode %>" style="background: linear-gradient(90deg, #3b82f6, #8b5cf6); border: none; border-radius: 50px; padding: 10px 28px; color: white; font-weight: 600;">
                    <i class="fas fa-eye me-2"></i>Xem trước kết quả
                </button>
                <button type="button" class="btn btn-outline-info" onclick="resetIndicator('<%= indicatorCode %>')" style="border: 1.5px solid #60a5fa; color: #60a5fa; border-radius: 50px; padding: 10px 28px; background: transparent;">
                    <i class="fas fa-undo-alt me-2"></i>Đặt lại
                </button>
            </div>
            
            <div class="chart-container mt-4" id="chart_<%= indicatorCode %>" style="display: none; background: rgba(30, 41, 59, 0.5); border-radius: 12px; padding: 15px;">
                <canvas id="<%= indicatorCode.toLowerCase() %>Chart"></canvas>
            </div>
        </div>
    </div>
</div>