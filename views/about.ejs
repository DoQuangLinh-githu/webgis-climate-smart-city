<!-- views/about.ejs -->
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="description" content="Tìm hiểu về Climate Smart City - Nền tảng quản lý và phân tích dữ liệu thành phố thông minh bền vững.">
    <title>Giới Thiệu - Climate Smart City</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/ai-chatbot.css">
    <style>
        /* About page specific styles */
        .about-header {
            text-align: center;
            margin-bottom: 30px;
        }
        .about-header .logo-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            border-radius: 25px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.3);
        }
        .about-header .logo-icon i {
            font-size: 40px;
            color: white;
        }
        .about-header h2 {
            font-size: 2rem;
            font-weight: 800;
            background: linear-gradient(90deg, #fff, #94a3b8);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }
        .about-header p {
            color: #94a3b8;
            font-size: 1rem;
        }

        /* Stats section */
        .about-stats {
            display: flex;
            justify-content: space-around;
            margin: 30px 0;
            flex-wrap: wrap;
            gap: 20px;
        }
        .stat-item {
            text-align: center;
            background: rgba(59, 130, 246, 0.1);
            padding: 25px 20px;
            border-radius: 25px;
            flex: 1;
            min-width: 120px;
            transition: all 0.3s ease;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }
        .stat-item:hover {
            transform: translateY(-5px);
            background: rgba(59, 130, 246, 0.15);
            border-color: #3b82f6;
        }
        .stat-number {
            font-size: 2.2rem;
            font-weight: 800;
            color: #60a5fa;
        }
        .stat-label {
            color: #94a3b8;
            font-size: 0.85rem;
            margin-top: 5px;
        }

        /* Mission Vision */
        .mission-vision {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin: 30px 0;
        }
        .mission-card {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.08));
            padding: 25px;
            border-radius: 25px;
            text-align: center;
            transition: all 0.3s ease;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }
        .mission-card:hover {
            transform: translateY(-5px);
            border-color: #3b82f6;
            background: rgba(59, 130, 246, 0.12);
        }
        .mission-card i {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }
        .mission-card h5 {
            color: white;
            font-weight: 700;
            margin-bottom: 10px;
        }
        .mission-card p {
            color: #94a3b8;
            font-size: 0.9rem;
            line-height: 1.5;
        }

        /* Features grid */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }
        .feature-card {
            background: rgba(30, 41, 59, 0.7);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 20px;
            padding: 20px;
            transition: all 0.3s ease;
            display: flex;
            align-items: flex-start;
            gap: 15px;
        }
        .feature-card:hover {
            transform: translateY(-5px);
            background: rgba(59, 130, 246, 0.12);
            border-color: #3b82f6;
        }
        .feature-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .feature-icon i {
            font-size: 1.5rem;
            color: white;
        }
        .feature-content h6 {
            color: white;
            font-weight: 700;
            margin-bottom: 8px;
        }
        .feature-content p {
            color: #94a3b8;
            font-size: 0.85rem;
            margin: 0;
            line-height: 1.5;
        }

        /* Domains list */
        .domains-list {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin: 20px 0;
        }
        .domain-tag {
            background: rgba(59, 130, 246, 0.15);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 50px;
            padding: 8px 18px;
            font-size: 0.85rem;
            color: #cbd5e1;
            transition: all 0.3s ease;
        }
        .domain-tag:hover {
            background: rgba(59, 130, 246, 0.3);
            transform: translateY(-2px);
        }
        .domain-tag strong {
            color: #60a5fa;
        }

        /* CTA Buttons */
        .cta-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 25px;
            flex-wrap: wrap;
        }
        .btn-about {
            background: linear-gradient(95deg, #3b82f6, #8b5cf6);
            border: none;
            padding: 12px 28px;
            font-weight: 600;
            border-radius: 50px;
            transition: all 0.3s ease;
        }
        .btn-about:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.4);
        }
        .btn-outline-about {
            background: transparent;
            border: 2px solid #3b82f6;
            padding: 12px 28px;
            font-weight: 600;
            border-radius: 50px;
            color: #3b82f6;
            transition: all 0.3s ease;
        }
        .btn-outline-about:hover {
            background: #3b82f6;
            color: white;
            transform: translateY(-3px);
        }

        @media (max-width: 768px) {
            .mission-vision {
                grid-template-columns: 1fr;
            }
            .features-grid {
                grid-template-columns: 1fr;
            }
            .stat-number {
                font-size: 1.8rem;
            }
            .about-header h2 {
                font-size: 1.6rem;
            }
        }
    </style>
</head>
<body>
    <div style="display: flex; min-height: 100vh;">
        <!-- AI Chatbot Component -->
        <%- include('partials/ai-chatbot') %>

        <!-- Nội dung Giới Thiệu -->
        <div class="content-section">
            <div class="content-card" style="max-width: 700px;">
                <!-- Navigation Tabs -->
                <div class="nav-tabs-custom">
                    <a href="/login" class="nav-tab"><i class="fas fa-sign-in-alt"></i> Đăng nhập</a>
                    <a href="/register" class="nav-tab"><i class="fas fa-user-plus"></i> Đăng ký</a>
                    <a href="/about" class="nav-tab active"><i class="fas fa-info-circle"></i> Giới thiệu</a>
                    <a href="/contact" class="nav-tab"><i class="fas fa-envelope"></i> Liên hệ</a>
                </div>

                <!-- Header -->
                <div class="about-header">
                    <div class="logo-icon">
                        <i class="fas fa-cloud-sun-rain"></i>
                    </div>
                    <h2>Về Climate Smart City</h2>
                    <p>Nền tảng thông minh hỗ trợ phát triển đô thị bền vững</p>
                </div>

                <!-- Giới thiệu chung -->
                <div style="margin-bottom: 30px;">
                    <p style="color: #cbd5e1; line-height: 1.7; text-align: center;">
                        <strong>Climate Smart City</strong> là nền tảng quản lý và phân tích dữ liệu môi trường thông minh, 
                        sử dụng trí tuệ nhân tạo (AI) và Internet of Things (IoT) để theo dõi chất lượng không khí, 
                        nhiệt độ, độ ẩm và các chỉ số môi trường khác tại TP. Hồ Chí Minh.
                    </p>
                </div>

                <!-- Sứ mệnh & Tầm nhìn -->
                <div class="mission-vision">
                    <div class="mission-card">
                        <i class="fas fa-bullseye text-primary"></i>
                        <h5>Sứ mệnh</h5>
                        <p>Xây dựng TP.HCM xanh - sạch - đẹp thông qua dữ liệu thông minh và công nghệ AI</p>
                    </div>
                    <div class="mission-card">
                        <i class="fas fa-eye text-primary"></i>
                        <h5>Tầm nhìn</h5>
                        <p>Trở thành đô thị thông minh hàng đầu Đông Nam Á vào năm 2030</p>
                    </div>
                </div>

                <!-- 5 lĩnh vực đánh giá -->
                <div style="margin: 30px 0;">
                    <h5 style="color: white; font-weight: 700; margin-bottom: 15px; text-align: center;">
                        <i class="fas fa-chart-pie me-2 text-primary"></i>5 Lĩnh vực đánh giá chính
                    </h5>
                    <div class="domains-list">
                        <span class="domain-tag"><strong>🔋 Năng lượng</strong> (8 tiêu chí)</span>
                        <span class="domain-tag"><strong>🏗️ Quy hoạch đô thị</strong> (7 tiêu chí)</span>
                        <span class="domain-tag"><strong>🚗 Giao thông & Không khí</strong> (10 tiêu chí)</span>
                        <span class="domain-tag"><strong>💧 Quản lý nước</strong> (8 tiêu chí)</span>
                        <span class="domain-tag"><strong>🗑️ Quản lý chất thải</strong> (8 tiêu chí)</span>
                    </div>
                    <p class="small text-secondary text-center mt-3">
                        Mỗi tiêu chí được chuẩn hóa với công thức tính toán, thang điểm từ 1-5, 
                        giúp việc theo dõi và đánh giá trở nên khoa học và minh bạch.
                    </p>
                </div>

                <!-- Tính năng nổi bật -->
                <h5 style="color: white; font-weight: 700; margin: 30px 0 15px; text-align: center;">
                    <i class="fas fa-star me-2 text-primary"></i>Tính năng nổi bật
                </h5>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-chart-line"></i></div>
                        <div class="feature-content">
                            <h6>Dashboard trực quan</h6>
                            <p>Hiển thị các chỉ số khí hậu và đô thị theo thời gian thực</p>
                        </div>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-map-marked-alt"></i></div>
                        <div class="feature-content">
                            <h6>Bản đồ thông minh</h6>
                            <p>Trực quan hóa dữ liệu GIS trên nền bản đồ tương tác</p>
                        </div>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-file-export"></i></div>
                        <div class="feature-content">
                            <h6>Xuất báo cáo</h6>
                            <p>Xuất dữ liệu dưới dạng CSV, Excel để phân tích chuyên sâu</p>
                        </div>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-history"></i></div>
                        <div class="feature-content">
                            <h6>Lịch sử dữ liệu</h6>
                            <p>Theo dõi mọi thay đổi và cập nhật dữ liệu theo thời gian</p>
                        </div>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-robot"></i></div>
                        <div class="feature-content">
                            <h6>Phân tích AI</h6>
                            <p>Dự báo xu hướng và cảnh báo sớm các vấn đề môi trường</p>
                        </div>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-shield-alt"></i></div>
                        <div class="feature-content">
                            <h6>Bảo mật cao</h6>
                            <p>Mã hóa dữ liệu và phân quyền người dùng chi tiết</p>
                        </div>
                    </div>
                </div>

                <!-- CTA Buttons -->
                <div class="cta-buttons">
                    <a href="/register" class="btn btn-about text-white">
                        <i class="fas fa-user-plus me-2"></i>Đăng ký ngay
                    </a>
                    <a href="/contact" class="btn-outline-about">
                        <i class="fas fa-envelope me-2"></i>Liên hệ
                    </a>
                </div>

                <!-- Footer text -->
                <div class="text-center mt-4 pt-3">
                    <p class="small text-secondary">
                        <i class="fas fa-shield-alt me-1"></i> Bảo mật bởi JWT & AES-256
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ai-chatbot.js"></script>
</body>
</html>