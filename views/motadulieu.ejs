<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mô Tả Dữ Liệu - Climate Smart City</title>
    
    <!-- CSS Libraries -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Common CSS -->
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/loading.css">

    <style>
        :root {
            --primary: #3b82f6;
            --secondary: #8b5cf6;
            --text-muted: #94a3b8;
            --glass: rgba(15, 23, 42, 0.6);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: #f8fafc;
            min-height: 100vh;
        }

        .main-content {
            margin-left: 280px;
            padding: 30px;
            min-height: 100vh;
            transition: margin-left 0.3s ease;
        }

        @media (max-width: 992px) {
            .main-content {
                margin-left: 0;
                padding: 80px 20px 30px 20px;
            }
        }

        .page-header {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(139, 92, 246, 0.15));
            border: 1px solid rgba(59, 130, 246, 0.4);
            border-radius: 24px;
            padding: 35px;
            margin-bottom: 30px;
            backdrop-filter: blur(10px);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 800;
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        /* 5 TAB DESIGN */
        .data-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 30px;
            background: rgba(15, 23, 42, 0.6);
            padding: 12px 20px;
            border-radius: 60px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(59, 130, 246, 0.3);
        }

        .tab-button {
            padding: 12px 28px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.95rem;
            background: transparent;
            border: none;
            color: #cbd5e1;
            transition: all 0.3s ease;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .tab-button i {
            font-size: 1.1rem;
        }

        .tab-button.active {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
        }

        .tab-button:hover:not(.active) {
            color: white;
            background: rgba(59, 130, 246, 0.2);
        }

        .tab-content {
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        footer {
            text-align: center;
            padding: 40px 20px 20px;
            color: var(--text-muted);
            border-top: 1px solid rgba(59, 130, 246, 0.2);
            margin-top: 40px;
        }
    </style>
</head>
<body>

    <!-- Header + Sidebar -->
    <% 
        let currentPage = 'motadulieu';
        let user = locals.user;
    %>
    <%- include('partials/header') %>

    <!-- Main Content -->
    <main class="main-content">
        <div class="page-header animate__animated animate__fadeIn">
            <h1 class="page-title"><i class="fas fa-database me-3"></i>Mô Tả Dữ Liệu</h1>
            <p class="lead text-white">Chi tiết các chỉ số và nguồn dữ liệu phục vụ đánh giá Climate Smart City TP.HCM</p>
        </div>

        <!-- 5 TABS -->
        <div class="data-tabs">
            <button class="tab-button active" data-tab="tab1">
                <i class="fas fa-bolt"></i> Lĩnh vực 1: Năng lượng
            </button>
            <button class="tab-button" data-tab="tab2">
                <i class="fas fa-city"></i> Lĩnh vực 2: Quy hoạch đô thị & Môi trường
            </button>
            <button class="tab-button" data-tab="tab3">
                <i class="fas fa-bus"></i> Lĩnh vực 3: Giao thông vận tải
            </button>
            <button class="tab-button" data-tab="tab4">
                <i class="fas fa-tint"></i> Lĩnh vực 4: Quản lý nước
            </button>
            <button class="tab-button" data-tab="tab5">
                <i class="fas fa-recycle"></i> Lĩnh vực 5: Quản lý chất thải
            </button>
        </div>

        <!-- Nội dung các tab (include từ file nhỏ) -->
        <div id="tab1" class="tab-content active">
            <%- include('motadulieu/tab1-nangluong') %>
        </div>
        <div id="tab2" class="tab-content">
            <%- include('motadulieu/tab2-quyhoach') %>
        </div>
        <div id="tab3" class="tab-content">
            <%- include('motadulieu/tab3-giaothong') %>
        </div>
        <div id="tab4" class="tab-content">
            <%- include('motadulieu/tab4-nuoc') %>
        </div>
        <div id="tab5" class="tab-content">
            <%- include('motadulieu/tab5-chatthai') %>
        </div>

        <footer>
            <p><i class="fas fa-cloud-sun-rain me-2"></i> Hệ thống Quản lý Dữ liệu Thông minh TP.HCM • 2026</p>
        </footer>
    </main>

    <!-- Footer + Scripts -->
    <%- include('partials/footer') %>

    <script>
        // Tab switching
        document.querySelectorAll('.tab-button').forEach(button => {
            button.addEventListener('click', () => {
                const tabId = button.getAttribute('data-tab');
                
                // Remove active class from all buttons and contents
                document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
                
                // Add active class to current button and content
                button.classList.add('active');
                document.getElementById(tabId).classList.add('active');
            });
        });
    </script>
</body>
</html>