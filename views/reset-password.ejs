<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đặt Lại Mật Khẩu - Climate Smart City</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #3b82f6;
            --secondary: #8b5cf6;
            --success: #10b981;
            --danger: #ef4444;
            --dark: #0f172a;
            --light: #f8fafc;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .main-container {
            width: 100%;
            max-width: 480px;
            padding: 20px;
        }

        .card {
            background: rgba(15, 23, 42, 0.78);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(59, 130, 246, 0.4);
            border-radius: 24px;
            padding: 45px 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
            animation: fadeInScale 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        @keyframes fadeInScale {
            from {
                opacity: 0;
                transform: scale(0.88) translateY(40px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .logo-title {
            text-align: center;
            margin-bottom: 35px;
        }

        .logo-title i {
            font-size: 3.5rem;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 14px;
            display: block;
        }

        .logo-title h2 {
            font-size: 2.25rem;
            font-weight: 900;
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
        }

        .form-label {
            color: #cbd5e1;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .form-control {
            background: rgba(30, 41, 59, 0.88);
            border: 1px solid rgba(59, 130, 246, 0.45);
            color: #f8fafc;
            border-radius: 14px;
            padding: 15px 20px;
            font-size: 1.03rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            background: rgba(30, 41, 59, 0.95);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.28);
            transform: translateY(-2px);
        }

        .form-control::placeholder {
            color: #94a3b8;
        }

        .btn-primary {
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            border: none;
            padding: 15px 32px;
            font-weight: 700;
            border-radius: 14px;
            width: 100%;
            font-size: 1.06rem;
            transition: all 0.35s ease;
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 40px rgba(59, 130, 246, 0.5);
        }

        .btn-outline-light {
            border: 2px solid rgba(248, 250, 252, 0.6);
            color: #f8fafc;
            border-radius: 14px;
            padding: 14px 32px;
            font-weight: 600;
            width: 100%;
            margin-top: 14px;
            transition: all 0.3s ease;
        }

        .btn-outline-light:hover {
            background: rgba(248, 250, 252, 0.1);
            border-color: #f8fafc;
            transform: translateY(-2px);
        }

        .alert {
            border-radius: 14px;
            padding: 16px 22px;
            font-weight: 500;
            margin-bottom: 24px;
            border: none;
        }

        @media (max-width: 576px) {
            .card {
                padding: 35px 25px;
            }
            .logo-title h2 {
                font-size: 1.95rem;
            }
            .logo-title i {
                font-size: 3rem;
            }
        }
    </style>
</head>
<body>

    <div class="main-container">
        <div class="card">
            <!-- Header -->
            <div class="logo-title">
                <i class="fas fa-cloud-sun-rain"></i>
                <h2>Climate Smart City</h2>
                <p class="text-muted mt-2">TP. Hồ Chí Minh</p>
            </div>

            <h3 class="text-center mb-3"><i class="fas fa-lock me-2"></i>Đặt Lại Mật Khẩu</h3>
            <p class="text-center text-muted mb-4" style="font-size: 1.02rem;">
                Nhập mật khẩu mới để hoàn tất việc đặt lại tài khoản của bạn
            </p>

            <!-- Alerts -->
            <% if (error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i><%= error %>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            <% } %>

            <% if (success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i><%= success %>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            <% } %>

            <!-- Form -->
            <form method="POST" action="/reset-password" class="needs-validation" novalidate id="resetForm">
                <input type="hidden" name="token" value="<%= token || '' %>">

                <div class="mb-4">
                    <label for="password" class="form-label">Mật khẩu mới</label>
                    <input type="password" 
                           class="form-control" 
                           id="password" 
                           name="password" 
                           placeholder="Nhập mật khẩu mới" 
                           required 
                           minlength="8">
                    <div class="invalid-feedback">
                        Mật khẩu phải có ít nhất 8 ký tự.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="confirm-password" class="form-label">Xác nhận mật khẩu</label>
                    <input type="password" 
                           class="form-control" 
                           id="confirm-password" 
                           name="confirm-password" 
                           placeholder="Xác nhận mật khẩu mới" 
                           required>
                    <div class="invalid-feedback">
                        Mật khẩu xác nhận không khớp.
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <span class="spinner-border spinner-border-sm me-2 d-none" id="spinner" role="status"></span>
                    <i class="fas fa-key me-2"></i>Đặt Lại Mật Khẩu
                </button>

                <a href="/login" class="btn btn-outline-light mt-3">
                    <i class="fas fa-arrow-left me-2"></i>Quay lại Đăng Nhập
                </a>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Form validation & password match
        (function () {
            'use strict';
            const form = document.getElementById('resetForm');
            const submitBtn = document.getElementById('submitBtn');
            const password = document.getElementById('password');
            const confirmPassword = document.getElementById('confirm-password');

            form.addEventListener('submit', function (event) {
                if (!form.checkValidity() || password.value !== confirmPassword.value) {
                    event.preventDefault();
                    event.stopPropagation();

                    if (password.value !== confirmPassword.value) {
                        confirmPassword.setCustomValidity('Mật khẩu xác nhận không khớp');
                    } else {
                        confirmPassword.setCustomValidity('');
                    }
                } else {
                    // Loading effect
                    submitBtn.disabled = true;
                    const spinner = document.getElementById('spinner');
                    if (spinner) spinner.classList.remove('d-none');
                    submitBtn.innerHTML = `
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        Đang xử lý...
                    `;
                }
                form.classList.add('was-validated');
            });

            // Real-time password match validation
            confirmPassword.addEventListener('input', function () {
                if (password.value === confirmPassword.value) {
                    confirmPassword.setCustomValidity('');
                } else {
                    confirmPassword.setCustomValidity('Mật khẩu xác nhận không khớp');
                }
            });
        })();
    </script>
</body>
</html>