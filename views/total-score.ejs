<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đồ Thị Dự Đoán Biến Đổi Khí Hậu - Climate Smart City TP.HCM</title>
    
    <!-- CSS Libraries -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    
    <!-- Common CSS -->
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/loading.css">

    <!-- Page Specific CSS -->
    <style>
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid rgba(59, 130, 246, 0.4);
            border-radius: 20px;
            padding: 24px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            text-align: center;
        }

        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(59, 130, 246, 0.25);
            border-color: var(--primary);
        }

        .stat-icon {
            font-size: 2.5rem;
            margin-bottom: 12px;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #94a3b8;
            font-size: 0.85rem;
        }

        .stat-trend {
            font-size: 0.75rem;
            margin-top: 8px;
            color: #f59e0b;
        }

        .trend-up { color: #ef4444; }
        .trend-down { color: #10b981; }

        .control-panel, .chart-wrapper, .alert-section {
            background: rgba(15, 23, 42, 0.65);
            border: 1px solid rgba(59, 130, 246, 0.35);
            border-radius: 20px;
            padding: 28px;
            margin-bottom: 28px;
            backdrop-filter: blur(16px);
        }

        .form-label {
            color: #cbd5e1;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .form-select {
            background: rgba(30, 41, 59, 0.85);
            border: 1px solid rgba(59, 130, 246, 0.45);
            color: #f8fafc;
            border-radius: 12px;
            padding: 12px 16px;
        }

        .form-select:focus {
            background: rgba(30, 41, 59, 0.95);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.25);
        }

        .chart-container {
            position: relative;
            height: 420px;
        }

        .chart-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(59, 130, 246, 0.2);
            border: 1px solid rgba(59, 130, 246, 0.4);
            color: var(--primary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .chart-btn:hover {
            background: rgba(59, 130, 246, 0.45);
            transform: scale(1.1);
        }

        .alert-item {
            background: rgba(239, 68, 68, 0.12);
            border-left: 4px solid var(--danger);
            border-radius: 14px;
            padding: 18px;
            margin-bottom: 16px;
            display: flex;
            gap: 16px;
            transition: all 0.3s;
        }

        .alert-item:hover {
            transform: translateX(6px);
            background: rgba(239, 68, 68, 0.18);
        }

        .alert-item:last-child { margin-bottom: 0; }

        .alert-icon { font-size: 1.8rem; flex-shrink: 0; }
        .alert-item h6 { font-weight: 700; margin-bottom: 5px; color: #f8fafc; }
        .alert-item p { color: #cbd5e1; margin-bottom: 5px; font-size: 0.9rem; }

        .impact-grid, .solution-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .impact-card, .solution-card {
            background: rgba(15, 23, 42, 0.65);
            border: 1px solid rgba(59, 130, 246, 0.35);
            border-radius: 20px;
            padding: 24px;
            transition: all 0.3s ease;
        }

        .impact-card:hover, .solution-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(59, 130, 246, 0.2);
        }

        .framework-container {
            background: rgba(15, 23, 42, 0.65);
            border: 1px solid rgba(59, 130, 246, 0.35);
            border-radius: 20px;
            padding: 32px;
            text-align: center;
        }

        .framework-img {
            max-width: 100%;
            border-radius: 16px;
            margin-top: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .last-updated {
            color: #94a3b8;
            font-size: 0.85rem;
            margin-top: 15px;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            background: #10b981;
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(1.2); }
        }

        @media (max-width: 768px) {
            .chart-container { height: 320px; }
            .impact-grid, .solution-grid { grid-template-columns: 1fr; }
            .alert-item { flex-direction: column; gap: 10px; }
        }
    </style>
</head>
<body>

    <!-- Header + Sidebar -->
    <% 
        let currentPage = 'total-score';
        let user = locals.user;
    %>
    <%- include('partials/header') %>

    <!-- Main content -->
    <main class="main-content">
        <div class="page-header animate__animated animate__fadeIn">
            <h1 class="page-title"><i class="fas fa-chart-line me-3"></i> Đồ Thị Dự Đoán Biến Đổi Khí Hậu</h1>
            <p class="lead text-center text-muted">Dự báo xu hướng biến đổi khí hậu và tác động đến TP. Hồ Chí Minh</p>
            <div class="last-updated">
                <i class="fas fa-clock me-1"></i> Cập nhật: <span id="currentTime">--/--/---- --:--</span> | 
                <i class="fas fa-database me-1"></i> Nguồn: IPCC, NASA, World Bank, UBND TP.HCM
            </div>
            <div class="d-flex flex-wrap gap-3 align-items-center justify-content-center mt-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="status-dot"></div>
                    <span class="small">Hệ thống hoạt động bình thường</span>
                </div>
                <button class="btn btn-primary-custom" onclick="location.reload()" style="padding: 8px 24px;">
                    <i class="fas fa-sync-alt me-2"></i>Tải Lại
                </button>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid animate__animated animate__fadeInUp">
            <div class="stat-card">
                <div class="stat-icon">🌡️</div>
                <div class="stat-value" id="tempNow">32.8°C</div>
                <div class="stat-label">Nhiệt độ hiện tại</div>
                <div class="stat-trend"><i class="fas fa-arrow-up"></i> +1.5°C so với trung bình</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🌊</div>
                <div class="stat-value" id="seaNow">+142cm</div>
                <div class="stat-label">Mực nước biển + lún đất</div>
                <div class="stat-trend"><i class="fas fa-arrow-up"></i> So với năm 2000</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">💨</div>
                <div class="stat-value" id="co2Now">425ppm</div>
                <div class="stat-label">Nồng độ CO₂</div>
                <div class="stat-trend"><i class="fas fa-arrow-up"></i> +2.8ppm/năm</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🏙️</div>
                <div class="stat-value" id="heatNow">+3.8°C</div>
                <div class="stat-label">Đảo nhiệt đô thị</div>
                <div class="stat-trend"><i class="fas fa-arrow-up"></i> So với ngoại ô</div>
            </div>
        </div>

        <!-- Controls -->
        <div class="control-panel animate__animated animate__fadeInUp">
            <h4 class="mb-4"><i class="fas fa-sliders-h me-2" style="color: var(--primary);"></i> Điều Khiển Đồ Thị</h4>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Chọn chỉ số</label>
                    <select id="indicatorSelect" class="form-select">
                        <option value="temp">Nhiệt độ toàn cầu (°C anomaly)</option>
                        <option value="co2">Nồng độ CO₂ (ppm)</option>
                        <option value="hcm_sea" selected>Mực nước biển + lún đất TP.HCM (cm)</option>
                        <option value="hcm_heat">Đảo nhiệt đô thị TP.HCM (°C)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Khoảng năm</label>
                    <select id="yearRange" class="form-select">
                        <option value="2020-2040">2020 - 2040</option>
                        <option value="2025-2050" selected>2025 - 2050</option>
                        <option value="2030-2070">2030 - 2070</option>
                        <option value="2000-2100">2000 - 2100 (Full)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Kịch bản IPCC</label>
                    <select id="scenarioSelect" class="form-select">
                        <option value="ssp1">SSP1-1.9 (Tốt nhất)</option>
                        <option value="ssp2" selected>SSP2-4.5 (Trung bình)</option>
                        <option value="ssp5">SSP5-8.5 (Xấu nhất)</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Alert Section -->
        <div class="alert-section animate__animated animate__fadeInUp">
            <h4 class="mb-4"><i class="fas fa-exclamation-triangle me-2" style="color: var(--warning);"></i> Cảnh Báo Dự Đoán</h4>
            <div class="alert-item">
                <div class="alert-icon"><i class="fas fa-water"></i></div>
                <div>
                    <h6>Nguy Cơ Ngập Cao - Năm 2050</h6>
                    <p>Dự đoán AI: <strong>20-40% diện tích TP.HCM</strong> có nguy cơ ngập thường xuyên do mực nước biển dâng và lún đất.</p>
                    <small><i class="fas fa-brain me-1"></i> Độ tin cậy: 87%</small>
                </div>
            </div>
            <div class="alert-item" style="border-left-color: var(--warning);">
                <div class="alert-icon"><i class="fas fa-temperature-high"></i></div>
                <div>
                    <h6>Tăng Nhiệt Độ Cực Đoan</h6>
                    <p>Đảo nhiệt đô thị dự kiến tăng lên <strong>5-6°C</strong> vào năm 2070, ảnh hưởng nghiêm trọng đến sức khỏe cộng đồng.</p>
                    <small><i class="fas fa-brain me-1"></i> Độ tin cậy: 92%</small>
                </div>
            </div>
        </div>

        <!-- Main Prediction Chart -->
        <div class="chart-wrapper animate__animated animate__fadeInUp">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <h4 class="chart-title mb-0" id="chartTitle">
                    <i class="fas fa-chart-line me-2"></i> Suy đoán mực nước biển dâng + lún đất tại TP.HCM
                </h4>
                <div class="d-flex gap-2">
                    <div class="chart-btn" onclick="downloadChart()" title="Tải xuống"><i class="fas fa-download"></i></div>
                    <div class="chart-btn" onclick="toggleFullscreen()" title="Toàn màn hình"><i class="fas fa-expand"></i></div>
                    <div class="chart-btn" onclick="shareChart()" title="Chia sẻ"><i class="fas fa-share-alt"></i></div>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="predictionChart"></canvas>
            </div>
        </div>

        <!-- Secondary Charts -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="chart-wrapper">
                    <h5 class="mb-4"><i class="fas fa-temperature-high me-2"></i> Nhiệt Độ & Đảo Nhiệt</h5>
                    <div class="chart-container" style="height: 340px;"><canvas id="tempChart"></canvas></div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="chart-wrapper">
                    <h5 class="mb-4"><i class="fas fa-smog me-2"></i> Nồng Độ CO₂</h5>
                    <div class="chart-container" style="height: 340px;"><canvas id="co2Chart"></canvas></div>
                </div>
            </div>
        </div>

        <!-- Impact Section -->
        <div class="mb-4">
            <h3 class="mb-4 text-center"><i class="fas fa-exclamation-circle me-2" style="color: var(--danger);"></i> Tác Động Biến Đổi Khí Hậu Đến TP.HCM</h3>
            <div class="impact-grid">
                <div class="impact-card"><h5>🌊 Ngập lụt</h5><p>Diện tích ngập tăng 3-5 lần vào năm 2050, ảnh hưởng đến 2-3 triệu dân.</p></div>
                <div class="impact-card"><h5>🏭 Năng lượng</h5><p>Tăng 30-40% nhu cầu điện vào mùa hè do nhiệt độ tăng.</p></div>
                <div class="impact-card"><h5>💧 Nguồn nước</h5><p>Xâm nhập mặn sâu 80-100km vào nội địa, thiếu nước ngọt sinh hoạt.</p></div>
                <div class="impact-card"><h5>🏥 Sức khỏe</h5><p>Bệnh truyền nhiễm tăng 25-35% do thay đổi nhiệt độ và độ ẩm.</p></div>
                <div class="impact-card"><h5>💰 Kinh tế</h5><p>Thiệt hại ước tính 3-5% GDP/năm vào năm 2050.</p></div>
                <div class="impact-card"><h5>🌾 Nông nghiệp</h5><p>Năng suất lúa giảm 20-30%, diện tích nuôi trồng thủy sản thu hẹp.</p></div>
            </div>
        </div>

        <!-- Solution Section -->
        <div class="mb-4">
            <h3 class="mb-4 text-center"><i class="fas fa-lightbulb me-2" style="color: var(--warning);"></i> Giải Pháp Climate Smart City</h3>
            <div class="solution-grid">
                <div class="solution-card"><h5>🌳 Cây xanh đô thị</h5><p>Trồng 1 triệu cây xanh, giảm 2-3°C đảo nhiệt đô thị.</p></div>
                <div class="solution-card"><h5>💧 Tái tạo nước</h5><p>Hệ thống tái tạo nước mưa và nước thải sinh hoạt.</p></div>
                <div class="solution-card"><h5>🔋 Năng lượng tái tạo</h5><p>Chuyển đổi 50% năng lượng sang mặt trời, gió vào năm 2035.</p></div>
                <div class="solution-card"><h5>🏗️ Công trình xanh</h5><p>Áp dụng tiêu chuẩn LOTUS, LEED cho 70% công trình mới.</p></div>
                <div class="solution-card"><h5>🚆 Giao thông xanh</h5><p>Phát triển metro, xe buýt điện, giảm 40% khí thải CO₂.</p></div>
                <div class="solution-card"><h5>🤖 AI giám sát</h5><p>Hệ thống AI dự báo và cảnh báo sớm thiên tai.</p></div>
            </div>
        </div>

        <!-- Framework -->
        <div class="framework-container">
            <h3 class="mb-4"><i class="fas fa-network-wired me-2" style="color: var(--primary);"></i> Khung Climate Smart City Assessment Framework</h3>
            <p class="text-muted" style="max-width: 700px; margin: 0 auto 20px;">
                Hệ thống tích hợp đầy đủ các thành phần của một thành phố thông minh thích ứng với biến đổi khí hậu.
            </p>
            <img src="https://www.iiot-world.com/wp-content/uploads/2018/01/the-smart-city-ecosystem-framework.jpg" alt="Smart City Framework" class="framework-img">
        </div>
    </main>

    <!-- Footer + Scripts -->
    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Page Specific Scripts -->
    <script>
        // ====================== INITIALIZATION ======================
        let predictionChart, tempChart, co2Chart;
        const scenarioMultiplier = { ssp1: 0.7, ssp2: 1.0, ssp5: 1.5 };

        const data = {
            temp: { labels: Array.from({length: 101}, (_, i) => 2000 + i), historical: Array.from({length: 25}, (_, i) => 0.8 + i * 0.024), projected: Array.from({length: 76}, (_, i) => 1.4 + i * 0.032) },
            co2: { labels: Array.from({length: 101}, (_, i) => 2000 + i), historical: Array.from({length: 25}, (_, i) => 370 + i * 2.2), projected: Array.from({length: 76}, (_, i) => 425 + i * 2.8) },
            hcm_sea: { labels: Array.from({length: 101}, (_, i) => 2000 + i), historical: Array.from({length: 25}, (_, i) => i * 4.8), projected: Array.from({length: 76}, (_, i) => 120 + i * 8.5) },
            hcm_heat: { labels: Array.from({length: 101}, (_, i) => 2000 + i), historical: Array.from({length: 25}, (_, i) => 1.2 + i * 0.08), projected: Array.from({length: 76}, (_, i) => 3.2 + i * 0.065) }
        };

        function updateTime() {
            const now = new Date();
            document.getElementById('currentTime').textContent = now.toLocaleString('vi-VN', {
                day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit'
            });
        }

        function updateChart(indicator = 'hcm_sea', range = '2025-2050', scenario = 'ssp2') {
            if (predictionChart) predictionChart.destroy();

            const [start, end] = range.split('-').map(Number);
            const startIdx = start - 2000;
            const endIdx = end - 2000 + 1;
            const labels = data[indicator].labels.slice(startIdx, endIdx);

            const multiplier = scenarioMultiplier[scenario];
            const histStart = Math.max(0, startIdx);
            const histEnd = Math.min(25, endIdx);
            const projStart = Math.max(0, startIdx - 25);
            const projEnd = endIdx - 25;

            let histData = Array(labels.length).fill(null);
            let projData = Array(labels.length).fill(null);

            for (let i = histStart; i < histEnd; i++) {
                histData[i - startIdx] = data[indicator].historical[i];
            }
            for (let i = projStart; i < projEnd && i < data[indicator].projected.length; i++) {
                projData[i - projStart + Math.max(0, 25 - startIdx)] = data[indicator].projected[i] * multiplier;
            }

            const titles = {
                temp: 'Dự Đoán Nhiệt Độ Toàn Cầu',
                co2: 'Dự Đoán Nồng Độ CO₂',
                hcm_sea: 'Dự Đoán Mực Nước Biển Dâng + Lún Đất TP.HCM',
                hcm_heat: 'Dự Đoán Cường Độ Đảo Nhiệt Đô Thị TP.HCM'
            };

            document.getElementById('chartTitle').innerHTML = `<i class="fas fa-chart-line me-2"></i> ${titles[indicator]} (${scenario.toUpperCase()})`;

            const ctx = document.getElementById('predictionChart').getContext('2d');
            predictionChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        { label: 'Dữ liệu lịch sử', data: histData, borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.1)', fill: true, tension: 0.4, borderWidth: 3 },
                        { label: `Dự đoán AI (${scenario.toUpperCase()})`, data: projData, borderColor: '#ef4444', backgroundColor: 'rgba(239, 68, 68, 0.1)', borderDash: [8, 5], fill: true, tension: 0.4, borderWidth: 3 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#f8fafc' } } },
                    scales: { x: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(148, 163, 184, 0.1)' } }, y: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(148, 163, 184, 0.1)' } } }
                }
            });
        }

        function initSecondaryCharts() {
            const tempCtx = document.getElementById('tempChart').getContext('2d');
            tempChart = new Chart(tempCtx, {
                type: 'line',
                data: {
                    labels: data.temp.labels.slice(0, 51),
                    datasets: [{ label: 'Nhiệt độ toàn cầu', data: data.temp.historical.concat(data.temp.projected.slice(0, 26)), borderColor: '#ef4444', backgroundColor: 'rgba(239, 68, 68, 0.1)', fill: true, tension: 0.4 }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#f8fafc' } } } }
            });

            const co2Ctx = document.getElementById('co2Chart').getContext('2d');
            co2Chart = new Chart(co2Ctx, {
                type: 'line',
                data: {
                    labels: data.co2.labels.slice(0, 51),
                    datasets: [{ label: 'Nồng độ CO₂', data: data.co2.historical.concat(data.co2.projected.slice(0, 26)), borderColor: '#f59e0b', backgroundColor: 'rgba(245, 158, 11, 0.1)', fill: true, tension: 0.4 }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#f8fafc' } } } }
            });
        }

        function downloadChart() {
            if (predictionChart) {
                const link = document.createElement('a');
                link.download = 'climate-prediction-chart.png';
                link.href = predictionChart.toBase64Image();
                link.click();
            }
        }

        function toggleFullscreen() {
            const wrapper = document.querySelector('.chart-wrapper');
            if (!document.fullscreenElement) wrapper.requestFullscreen();
            else document.exitFullscreen();
        }

        function shareChart() {
            if (navigator.share) {
                navigator.share({ title: 'Dự đoán biến đổi khí hậu TP.HCM', url: window.location.href });
            } else {
                alert('Trình duyệt của bạn không hỗ trợ chức năng chia sẻ');
            }
        }

        // Event listeners
        document.addEventListener('DOMContentLoaded', () => {
            updateTime();
            setInterval(updateTime, 60000);
            updateChart();
            initSecondaryCharts();

            document.getElementById('indicatorSelect').addEventListener('change', () => {
                updateChart(
                    document.getElementById('indicatorSelect').value,
                    document.getElementById('yearRange').value,
                    document.getElementById('scenarioSelect').value
                );
            });
            document.getElementById('yearRange').addEventListener('change', () => {
                updateChart(
                    document.getElementById('indicatorSelect').value,
                    document.getElementById('yearRange').value,
                    document.getElementById('scenarioSelect').value
                );
            });
            document.getElementById('scenarioSelect').addEventListener('change', () => {
                updateChart(
                    document.getElementById('indicatorSelect').value,
                    document.getElementById('yearRange').value,
                    document.getElementById('scenarioSelect').value
                );
            });
        });
    </script>
</body>
