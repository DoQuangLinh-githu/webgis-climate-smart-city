<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xuất Báo Cáo | Climate Smart City</title>
    
    <!-- CSS Libraries -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Common CSS -->
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/loading.css">

    <!-- Page Specific CSS -->
    <style>
        :root {
            --primary: #3b82f6;
            --primary-dark: #2563eb;
            --secondary: #8b5cf6;
            --success: #10b981;
            --info: #06b6d4;
            --warning: #f59e0b;
            --danger: #ef4444;
            --dark: #0f172a;
            --gray: #94a3b8;
            --border: rgba(59, 130, 246, 0.2);
            --glass: rgba(15, 23, 42, 0.7);
            --glass-light: rgba(30, 41, 59, 0.5);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: #f8fafc;
            min-height: 100vh;
        }

        .main-content {
            margin-left: 280px;
            padding: 30px;
            min-height: 100vh;
            transition: margin-left 0.3s ease;
        }

        @media (max-width: 992px) {
            .main-content {
                margin-left: 0;
                padding: 80px 20px 30px 20px;
            }
        }

        /* Page Header */
        .page-header {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(139, 92, 246, 0.1));
            border: 1px solid var(--border);
            border-radius: 28px;
            padding: 40px;
            margin-bottom: 35px;
            backdrop-filter: blur(12px);
            position: relative;
            overflow: hidden;
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--secondary), var(--primary));
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 800;
            background: linear-gradient(135deg, #ffffff, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 12px;
        }

        /* Card Design */
        .export-card {
            background: var(--glass);
            border: 1px solid var(--border);
            border-radius: 28px;
            backdrop-filter: blur(16px);
            margin-bottom: 32px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .export-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            border-color: rgba(59, 130, 246, 0.5);
        }

        .card-header-gradient {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(139, 92, 246, 0.15));
            padding: 20px 28px;
            border-bottom: 1px solid var(--border);
        }

        .card-header-gradient h3 {
            margin: 0;
            font-size: 1.4rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .card-header-gradient h3 i {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 14px;
            font-size: 1.2rem;
        }

        .card-body {
            padding: 28px;
        }

        /* Form Elements */
        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            color: #cbd5e1;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-label i {
            color: var(--primary);
            font-size: 0.9rem;
        }

        .form-control, .form-select {
            background: rgba(30, 41, 59, 0.9);
            border: 1.5px solid var(--border);
            color: #f8fafc;
            border-radius: 16px;
            padding: 12px 16px;
            font-size: 0.95rem;
            transition: all 0.2s;
        }

        .form-control:focus, .form-select:focus {
            background: rgba(30, 41, 59, 1);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2);
            outline: none;
        }

        select[multiple] {
            background: rgba(30, 41, 59, 0.9);
        }

        select[multiple] option {
            padding: 10px;
            border-radius: 8px;
            margin: 2px 0;
        }

        select[multiple] option:checked {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
        }

        /* Buttons */
        .btn-export {
            border-radius: 50px;
            padding: 12px 32px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
        }

        .btn-export i {
            margin-right: 8px;
        }

        .btn-export:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }

        .btn-excel {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
        }

        .btn-csv {
            background: linear-gradient(135deg, #06b6d4, #0891b2);
            color: white;
        }

        .btn-outline-custom {
            background: transparent;
            border: 1.5px solid var(--border);
            color: #cbd5e1;
            border-radius: 12px;
            padding: 10px 20px;
            transition: all 0.3s;
        }

        .btn-outline-custom:hover {
            background: rgba(59, 130, 246, 0.2);
            border-color: var(--primary);
            color: white;
        }

        /* Filter Bar */
        .filter-bar {
            background: var(--glass-light);
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 24px;
            border: 1px solid var(--border);
        }

        /* Table */
        .data-table-wrapper {
            max-height: 520px;
            overflow-y: auto;
            border-radius: 20px;
            background: rgba(0, 0, 0, 0.2);
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

        .data-table thead th {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 14px 12px;
            font-weight: 600;
            position: sticky;
            top: 0;
            z-index: 10;
            white-space: nowrap;
        }

        .data-table tbody td {
            padding: 12px;
            border-bottom: 1px solid var(--border);
            color: #cbd5e1;
        }

        .data-table tbody tr:hover {
            background: rgba(59, 130, 246, 0.1);
        }

        /* Checkbox styling */
        .form-check-input {
            width: 18px;
            height: 18px;
            cursor: pointer;
            background-color: rgba(30, 41, 59, 0.9);
            border: 1.5px solid var(--border);
            border-radius: 5px;
        }

        .form-check-input:checked {
            background-color: var(--primary);
            border-color: var(--primary);
        }

        /* Selection bar */
        .selection-bar {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(139, 92, 246, 0.1));
            border-radius: 16px;
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
        }

        .selection-count {
            font-size: 0.9rem;
        }

        .selection-count span {
            color: var(--primary);
            font-weight: 700;
            font-size: 1.2rem;
        }

        /* Loading overlay */
        .loading-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(12px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 10000;
        }

        .loading-overlay.show {
            display: flex;
        }

        .loading-content {
            text-align: center;
        }

        .loading-spinner {
            width: 60px;
            height: 60px;
            border: 3px solid rgba(59, 130, 246, 0.3);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 20px;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Scrollbar */
        .data-table-wrapper::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .data-table-wrapper::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
        }

        .data-table-wrapper::-webkit-scrollbar-thumb {
            background: rgba(59, 130, 246, 0.5);
            border-radius: 10px;
        }

        .data-table-wrapper::-webkit-scrollbar-thumb:hover {
            background: var(--primary);
        }

        /* Alert */
        .alert-custom {
            border-radius: 16px;
            margin-bottom: 25px;
            animation: fadeInUp 0.4s ease;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .card-body {
                padding: 20px;
            }
            .page-header {
                padding: 25px;
            }
            .page-title {
                font-size: 1.8rem;
            }
            .btn-export {
                padding: 10px 20px;
                font-size: 0.85rem;
            }
            .data-table thead th,
            .data-table tbody td {
                padding: 8px;
                font-size: 0.75rem;
            }
            .selection-bar {
                flex-direction: column;
                align-items: stretch;
            }
            .btn-group {
                justify-content: center;
            }
        }

        /* Animation */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fadeInUp {
            animation: fadeInUp 0.6s ease forwards;
        }
    </style>
</head>
<body>

    <!-- Header + Sidebar -->
    <% 
        let currentPage = 'xuatbaocao';
        let user = locals.user;
    %>
    <%- include('partials/header') %>

    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-content">
            <div class="loading-spinner"></div>
            <h4 class="text-white mb-2">Đang xuất báo cáo...</h4>
            <p class="text-muted">Vui lòng chờ trong giây lát</p>
        </div>
    </div>

    <!-- Main content -->
    <main class="main-content">
        <div class="page-header animate-fadeInUp">
            <h1 class="page-title">
                <i class="fas fa-file-export me-3"></i> Xuất Báo Cáo
            </h1>
            <p class="lead text-muted mb-0">
                Xuất báo cáo tổng hợp và mô tả chỉ số Climate Smart City TP. Hồ Chí Minh
            </p>
        </div>

        <!-- BÁO CÁO TỔNG HỢP -->
        <div class="export-card animate-fadeInUp" style="animation-delay: 0.1s;">
            <div class="card-header-gradient">
                <h3>
                    <i class="fas fa-chart-line"></i>
                    Báo cáo tổng hợp
                </h3>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-7">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-calendar-alt"></i> Năm đánh giá
                            </label>
                            <select id="yearFilter3" class="form-select" multiple size="4">
                                <% if (years && years.length > 0) { %>
                                    <% years.forEach(y => { %>
                                        <option value="<%= y %>" <%= y === defaultYear ? 'selected' : '' %>><%= y %></option>
                                    <% }) %>
                                <% } else { %>
                                    <option value="2024">2024</option>
                                    <option value="2025" selected>2025</option>
                                    <option value="2026">2026</option>
                                <% } %>
                            </select>
                            <small class="text-muted mt-2 d-block">
                                <i class="fas fa-info-circle me-1"></i>Giữ phím Ctrl để chọn nhiều năm
                            </small>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-building"></i> Lĩnh vực
                            </label>
                            <select id="linhvucFilter3" class="form-select">
                                <option value="">-- Tất cả lĩnh vực --</option>
                                <option value="Năng lượng">⚡ Năng lượng</option>
                                <option value="Quy hoạch">🏙️ Quy hoạch đô thị & Môi trường</option>
                                <option value="Giao thông">🚌 Giao thông vận tải</option>
                                <option value="Quản lý nước">💧 Quản lý nước</option>
                                <option value="Quản lý chất thải">♻️ Quản lý chất thải</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="text-end mt-4 pt-2">
                    <button id="exportExcelBtn" class="btn-export btn-excel">
                        <i class="fas fa-file-excel me-2"></i>Xuất báo cáo Excel
                    </button>
                </div>
            </div>
        </div>

        <!-- XUẤT MÔ TẢ CHỈ SỐ -->
        <div class="export-card animate-fadeInUp" style="animation-delay: 0.2s;">
            <div class="card-header-gradient">
                <h3>
                    <i class="fas fa-list-ul"></i>
                    Xuất mô tả chỉ số
                </h3>
            </div>
            <div class="card-body">
                <!-- Filter Bar -->
                <div class="filter-bar">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">
                                <i class="fas fa-building"></i> Đơn vị cung cấp
                            </label>
                            <select id="donviFilter1" class="form-select">
                                <option value="">-- Tất cả --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">
                                <i class="fas fa-tags"></i> Lĩnh vực
                            </label>
                            <select id="linhvucFilter1" class="form-select">
                                <option value="">-- Tất cả --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">
                                <i class="fas fa-sliders-h"></i> Thao tác
                            </label>
                            <button id="resetFilter1" class="btn-outline-custom w-100">
                                <i class="fas fa-redo-alt me-1"></i> Đặt lại bộ lọc
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Selection Bar -->
                <div class="selection-bar">
                    <div class="btn-group btn-group-sm">
                        <button id="selectAll1" class="btn-outline-custom" style="border-radius: 10px 0 0 10px; padding: 8px 16px;">
                            <i class="fas fa-check-double me-1"></i> Chọn tất cả
                        </button>
                        <button id="deselectAll1" class="btn-outline-custom" style="border-radius: 0 10px 10px 0; padding: 8px 16px;">
                            <i class="fas fa-times me-1"></i> Bỏ chọn
                        </button>
                    </div>
                    <div class="selection-count">
                        Đã chọn <span id="selectedCount1">0</span> / <span id="totalCount1">0</span> chỉ số
                    </div>
                </div>

                <!-- Data Table -->
                <div class="data-table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 45px;">
                                    <input type="checkbox" id="masterCheckbox1" class="form-check-input">
                                </th>
                                <th>STT</th>
                                <th>Loại số liệu</th>
                                <th>Mô tả</th>
                                <th>Đơn vị</th>
                                <th>Lĩnh vực</th>
                                <th>Chỉ số</th>
                                <th>Đơn vị cung cấp</th>
                                <th>Lưu ý</th>
                            </tr>
                        </thead>
                        <tbody id="metadataTableBody1">
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="loading-spinner" style="width: 40px; height: 40px; margin: 0 auto 15px;"></div>
                                    <p class="text-muted">Đang tải dữ liệu...</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Export Buttons -->
                <div class="mt-4 pt-3 d-flex justify-content-end gap-3 flex-wrap">
                    <button id="exportMetaCsv1" class="btn-export btn-csv">
                        <i class="fas fa-file-csv me-2"></i>Xuất CSV
                    </button>
                    <button id="exportMetaExcel1" class="btn-export btn-excel">
                        <i class="fas fa-file-excel me-2"></i>Xuất Excel
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer + Scripts -->
    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Page Specific Scripts -->
    <script>
        // Loading overlay
        function showLoading() { 
            document.getElementById('loadingOverlay').classList.add('show'); 
        }
        function hideLoading() { 
            document.getElementById('loadingOverlay').classList.remove('show'); 
        }

        // Load filter options
        async function loadFilterOptions() {
            try {
                const res = await fetch('/api/metadata/filters');
                const data = await res.json();
                const linhvuc = data.linhvuc || [];
                const donvi = data.donvi || [];

                // Load cho Xuất Mô Tả Chỉ Số
                const donviFilter = document.getElementById('donviFilter1');
                const linhvucFilter = document.getElementById('linhvucFilter1');
                if (donviFilter) {
                    donviFilter.innerHTML = '<option value="">-- Tất cả --</option>';
                    donvi.forEach(v => {
                        if (v && v.trim()) donviFilter.appendChild(new Option(v, v));
                    });
                }
                if (linhvucFilter) {
                    linhvucFilter.innerHTML = '<option value="">-- Tất cả --</option>';
                    linhvuc.forEach(v => {
                        if (v && v.trim()) linhvucFilter.appendChild(new Option(v, v));
                    });
                }
            } catch (e) { 
                console.error('Lỗi load filter:', e); 
            }
        }

        // Load metadata list
        async function loadMetadataList1() {
            const tbody = document.getElementById('metadataTableBody1');
            tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5">
                <div class="loading-spinner" style="width: 40px; height: 40px; margin: 0 auto 15px;"></div>
                <p class="text-muted">Đang tải dữ liệu...</p>
            </td></tr>`;
            
            try {
                const donvi = document.getElementById('donviFilter1')?.value || '';
                const linhvuc = document.getElementById('linhvucFilter1')?.value || '';
                const res = await fetch(`/api/metadata/list?donvi=${encodeURIComponent(donvi)}&linhvuc=${encodeURIComponent(linhvuc)}`);
                const data = await res.json();
                
                document.getElementById('totalCount1').textContent = data.length || 0;
                
                if (!data.length) {
                    tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5 text-muted">
                        <i class="fas fa-inbox fa-3x mb-3 d-block" style="opacity: 0.5;"></i>
                        Không có dữ liệu phù hợp
                    </td></td>`;
                    return;
                }

                tbody.innerHTML = data.map(item => `
                    <tr>
                        <td style="text-align: center;"><input type="checkbox" class="form-check-input row-check1" value="${item.id}"></td>
                        <td style="text-align: center;">${item.stt || '-'}</td>
                        <td><strong>${escapeHtml(item.loai_so_lieu) || '-'}</strong></td>
                        <td style="max-width: 280px;">${escapeHtml(item.mo_ta) || '-'}</td>
                        <td>${escapeHtml(item.don_vi) || '-'}</td>
                        <td><span style="background: rgba(59,130,246,0.2); padding: 4px 10px; border-radius: 20px; font-size: 0.75rem;">${escapeHtml(item.linh_vuc) || '-'}</span></td>
                        <td>${escapeHtml(item.chi_so) || '-'}</td>
                        <td>${escapeHtml(item.don_vi_cung_cap) || '-'}</td>
                        <td style="max-width: 200px;">${escapeHtml(item.luu_y) || '-'}</td>
                    </tr>
                `).join('');
                updateSelectedCount1();
            } catch (e) {
                console.error('Lỗi tải metadata:', e);
                tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5 text-danger">
                    <i class="fas fa-exclamation-triangle fa-2x mb-2 d-block"></i>
                    Lỗi tải dữ liệu
                </td></td>`;
            }
        }

        // Escape HTML để tránh XSS
        function escapeHtml(str) {
            if (!str) return str;
            return str.replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }

        function updateSelectedCount1() {
            const checked = document.querySelectorAll('.row-check1:checked').length;
            const total = document.querySelectorAll('.row-check1').length;
            document.getElementById('selectedCount1').textContent = checked;
            const masterCb = document.getElementById('masterCheckbox1');
            if (masterCb) masterCb.checked = (checked === total && total > 0);
        }

        // ====================== XỬ LÝ NÚT XUẤT ======================
        
        // Xuất Excel cho Báo cáo Tổng Hợp
        const exportExcelBtn = document.getElementById('exportExcelBtn');
        if (exportExcelBtn) {
            exportExcelBtn.addEventListener('click', () => {
                const yearsSelect = document.getElementById('yearFilter3');
                const years = Array.from(yearsSelect.selectedOptions).map(opt => opt.value).join(',');
                const linhvuc = document.getElementById('linhvucFilter3')?.value || '';
                
                showLoading();
                window.location.href = `/export/comprehensive/excel?year=${encodeURIComponent(years)}&linhvuc=${encodeURIComponent(linhvuc)}`;
                setTimeout(hideLoading, 4000);
            });
        }

        // Xuất CSV cho Mô Tả Chỉ Số - GỬI DANH SÁCH ID ĐƯỢC CHỌN
        const exportMetaCsv1 = document.getElementById('exportMetaCsv1');
        if (exportMetaCsv1) {
            exportMetaCsv1.addEventListener('click', () => {
                // Lấy danh sách ID của các dòng được check
                const checkedIds = Array.from(document.querySelectorAll('.row-check1:checked'))
                    .map(cb => cb.value)
                    .join(',');
                
                // Lấy giá trị bộ lọc
                const donvi = document.getElementById('donviFilter1')?.value || '';
                const linhvuc = document.getElementById('linhvucFilter1')?.value || '';
                
                if (!checkedIds) {
                    alert('Vui lòng chọn ít nhất một chỉ số để xuất!');
                    return;
                }
                
                showLoading();
                window.location.href = `/export/metadata/csv?selected=${encodeURIComponent(checkedIds)}&donvi=${encodeURIComponent(donvi)}&linhvuc=${encodeURIComponent(linhvuc)}`;
                setTimeout(hideLoading, 3000);
            });
        }

        // Xuất Excel cho Mô Tả Chỉ Số - GỬI DANH SÁCH ID ĐƯỢC CHỌN
        const exportMetaExcel1 = document.getElementById('exportMetaExcel1');
        if (exportMetaExcel1) {
            exportMetaExcel1.addEventListener('click', () => {
                // Lấy danh sách ID của các dòng được check
                const checkedIds = Array.from(document.querySelectorAll('.row-check1:checked'))
                    .map(cb => cb.value)
                    .join(',');
                
                // Lấy giá trị bộ lọc
                const donvi = document.getElementById('donviFilter1')?.value || '';
                const linhvuc = document.getElementById('linhvucFilter1')?.value || '';
                
                if (!checkedIds) {
                    alert('Vui lòng chọn ít nhất một chỉ số để xuất!');
                    return;
                }
                
                showLoading();
                window.location.href = `/export/metadata/excel?selected=${encodeURIComponent(checkedIds)}&donvi=${encodeURIComponent(donvi)}&linhvuc=${encodeURIComponent(linhvuc)}`;
                setTimeout(hideLoading, 3000);
            });
        }

        // ====================== KHỞI TẠO TRANG ======================
        document.addEventListener('DOMContentLoaded', () => {
            loadFilterOptions();
            loadMetadataList1();

            // Reset filter
            const resetFilter1 = document.getElementById('resetFilter1');
            if (resetFilter1) {
                resetFilter1.onclick = () => {
                    const donviFilter = document.getElementById('donviFilter1');
                    const linhvucFilter = document.getElementById('linhvucFilter1');
                    if (donviFilter) donviFilter.value = '';
                    if (linhvucFilter) linhvucFilter.value = '';
                    loadMetadataList1();
                };
            }

            // Change filter
            ['donviFilter1', 'linhvucFilter1'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.addEventListener('change', loadMetadataList1);
            });

            // Checkbox master (chọn tất cả)
            const masterCheckbox1 = document.getElementById('masterCheckbox1');
            if (masterCheckbox1) {
                masterCheckbox1.addEventListener('change', function() {
                    document.querySelectorAll('.row-check1').forEach(cb => cb.checked = this.checked);
                    updateSelectedCount1();
                });
            }

            // Select all / Deselect all
            const selectAll1 = document.getElementById('selectAll1');
            const deselectAll1 = document.getElementById('deselectAll1');
            if (selectAll1) {
                selectAll1.onclick = () => {
                    document.querySelectorAll('.row-check1').forEach(cb => cb.checked = true);
                    updateSelectedCount1();
                };
            }
            if (deselectAll1) {
                deselectAll1.onclick = () => {
                    document.querySelectorAll('.row-check1').forEach(cb => cb.checked = false);
                    updateSelectedCount1();
                    if (masterCheckbox1) masterCheckbox1.checked = false;
                };
            }

            // Cập nhật số lượng khi click vào checkbox
            document.addEventListener('change', e => {
                if (e.target.classList && e.target.classList.contains('row-check1')) updateSelectedCount1();
            });
        });
    </script>
</body>
</html>