<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Dữ Liệu - Climate Smart City TP.HCM</title>
    
    <!-- CSS Libraries -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <!-- Common CSS -->
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/loading.css">

    <!-- Page Specific CSS -->
    <style>
        .stat-card {
            background: rgba(30, 41, 59, 0.6);
            border-radius: 20px;
            padding: 25px 20px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }
        .stat-card:hover {
            transform: translateY(-5px);
            background: rgba(30, 41, 59, 0.8);
            border-color: var(--primary);
        }
        .stat-icon {
            font-size: 2.2rem;
            margin-bottom: 12px;
        }
        .stat-value {
            font-size: 2rem;
            font-weight: 800;
        }
        .badge-level {
            padding: 6px 14px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.85rem;
        }
        .level-1 { background: #ef4444; color: white; }
        .level-2 { background: #f59e0b; color: white; }
        .level-3 { background: #3b82f6; color: white; }
        .level-4 { background: #10b981; color: white; }
        .level-5 { background: #8b5cf6; color: white; }
        .level-0 { background: #475569; color: white; }

        .control-panel, .table-container {
            background: rgba(15, 23, 42, 0.65);
            border: 1px solid rgba(59, 130, 246, 0.35);
            border-radius: 20px;
            padding: 28px;
            margin-bottom: 28px;
            backdrop-filter: blur(16px);
        }

        .form-control, .form-select {
            background: rgba(30, 41, 59, 0.88);
            border: 1px solid rgba(59, 130, 246, 0.45);
            color: #f8fafc;
            border-radius: 12px;
            padding: 12px 16px;
        }

        .form-control:focus, .form-select:focus {
            background: rgba(30, 41, 59, 0.95);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.25);
        }

        .table {
            color: #f8fafc;
            margin-bottom: 0;
        }
        .table thead {
            background: linear-gradient(90deg, var(--primary), var(--secondary));
        }
        .table th, .table td {
            border-color: rgba(59, 130, 246, 0.3);
            vertical-align: middle;
            padding: 12px;
        }
        .table tbody tr:hover {
            background: rgba(59, 130, 246, 0.15);
        }

        @media (max-width: 768px) {
            .control-panel, .table-container {
                padding: 20px;
            }
            .stat-value {
                font-size: 1.5rem;
            }
        }
    </style>
</head>
<body>

    <!-- Header + Sidebar -->
    <% 
        let currentPage = 'qldl';
        let user = locals.user;
    %>
    <%- include('partials/header') %>

    <!-- Main content -->
    <main class="main-content">
        <div class="page-header animate__animated animate__fadeIn">
            <h1 class="page-title"><i class="fas fa-database me-3"></i> Quản Lý Dữ Liệu</h1>
            <p class="lead text-center text-muted">Quản lý, chỉnh sửa và theo dõi toàn bộ chỉ số Climate Smart City</p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger animate__animated animate__shakeX">
                <i class="fas fa-exclamation-triangle me-2"></i><%= error %>
            </div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success animate__animated animate__bounceIn">
                <i class="fas fa-check-circle me-2"></i><%= success %>
            </div>
        <% } %>

        <!-- Tổng quan chỉ số -->
        <div class="control-panel animate__animated animate__fadeInUp">
            <h4 class="mb-4"><i class="fas fa-chart-bar me-2" style="color: var(--primary);"></i> Tổng Quan Chỉ Số</h4>
            <div class="row g-4">
                <div class="col-md-3 col-6">
                    <div class="stat-card text-center">
                        <div class="stat-icon" style="color: var(--primary);"><i class="fas fa-list-ul"></i></div>
                        <div class="stat-value"><%= assessments ? assessments.length : 0 %></div>
                        <div class="text-muted small">Tổng số chỉ số</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-card text-center">
                        <div class="stat-icon" style="color: var(--success);"><i class="fas fa-calendar-check"></i></div>
                        <div class="stat-value"><%= [...new Set(assessments.map(a => a.year_display))].length %></div>
                        <div class="text-muted small">Số năm dữ liệu</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-card text-center">
                        <div class="stat-icon" style="color: var(--warning);"><i class="fas fa-layer-group"></i></div>
                        <div class="stat-value"><%= [...new Set(assessments.map(a => a.domain_name))].length %></div>
                        <div class="text-muted small">Lĩnh vực</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-card text-center">
                        <div class="stat-icon" style="color: var(--info);"><i class="fas fa-clock"></i></div>
                        <div class="stat-value" style="font-size: 1.1rem;"><%= new Date().toLocaleDateString('vi-VN') %></div>
                        <div class="text-muted small">Cập nhật gần nhất</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bộ lọc & Tìm kiếm -->
        <div class="control-panel animate__animated animate__fadeInUp">
            <h4 class="mb-4"><i class="fas fa-filter me-2" style="color: var(--primary);"></i> Bộ Lọc & Tìm Kiếm</h4>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Tìm tên chỉ số</label>
                    <input type="text" id="searchInput" class="form-control" placeholder="Nhập tên chỉ số...">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Lĩnh vực</label>
                    <select id="domainFilter" class="form-select">
                        <option value="">Tất cả lĩnh vực</option>
                        <% if (assessments) { %>
                            <% [...new Set(assessments.map(a => a.domain_name))].sort().forEach(d => { %>
                                <option value="<%= d %>"><%= d %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Tháng</label>
                    <select id="monthFilter" class="form-select">
                        <option value="">Tất cả</option>
                        <% for(let m=1; m<=12; m++) { %>
                            <option value="<%= m %>">Tháng <%= m %></option>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Năm</label>
                    <select id="yearFilter" class="form-select">
                        <option value="">Tất cả năm</option>
                        <% if (years) { %>
                            <% years.forEach(y => { %>
                                <option value="<%= y %>" <%= y === selectedYear ? 'selected' : '' %>><%= y %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button id="clearFilters" class="btn btn-outline-light flex-fill">
                        <i class="fas fa-times me-2"></i>Xóa lọc
                    </button>
                    <button id="exportCsvBtn" class="btn btn-primary flex-fill">
                        <i class="fas fa-file-csv me-2"></i>CSV
                    </button>
                </div>
            </div>
        </div>

        <!-- Bảng dữ liệu -->
        <div class="table-container animate__animated animate__fadeInUp">
            <h4 class="mb-4"><i class="fas fa-table me-2" style="color: var(--primary);"></i> Danh Sách Chỉ Số Climate Smart City</h4>
            
            <% if (assessments && assessments.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover" id="dataTable">
                        <thead>
                            <tr>
                                <th>Lĩnh vực</th>
                                <th>Chỉ số</th>
                                <th>Giá trị</th>
                                <th>Điểm</th>
                                <th>Cấp độ</th>
                                <th>Mô tả</th>
                                <th>Ngày cập nhật</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="dataTableBody">
                            <% assessments.forEach(ass => { %>
                                <tr data-domain="<%= ass.domain_name || '' %>" 
                                    data-month="<%= ass.month || '' %>" 
                                    data-year="<%= ass.year_display || '' %>">
                                    <td><%= ass.domain_name || '—' %></td>
                                    <td><%= ass.indicator_name || '—' %></td>
                                    <td><%= ass.value !== null && ass.value !== undefined ? ass.value : '—' %></td>
                                    <td><%= ass.score_awarded !== null && ass.score_awarded !== undefined ? ass.score_awarded : '—' %></td>
                                    <td>
                                        <% if (ass.level !== null && ass.level !== undefined) { %>
                                            <span class="badge-level level-<%= ass.level %>">Cấp <%= ass.level %></span>
                                        <% } else { %>
                                            <span class="badge-level level-0">N/A</span>
                                        <% } %>
                                     </td>
                                    <td><%= ass.description || 'Chưa có dữ liệu' %></td>
                                    <td><%= ass.date_obj ? new Date(ass.date_obj).toLocaleDateString('vi-VN') : '—' %></td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a href="/edit_cndl/<%= ass.assessment_id %>" class="btn btn-sm btn-primary">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form action="/qldl/delete/<%= ass.assessment_id %>" method="POST" onsubmit="return handleDelete(event, this)" style="display: inline;">
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                     </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="fas fa-database fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">Chưa có dữ liệu nào được nhập</h5>
                    <p class="text-muted">Nhấn nút "Cập Nhật Dữ Liệu" để bắt đầu nhập chỉ số mới.</p>
                    <a href="/cndl" class="btn btn-primary mt-3">Cập Nhật Dữ Liệu</a>
                </div>
            <% } %>
        </div>
    </main>

    <!-- Footer + Scripts -->
    <%- include('partials/footer') %>

    <!-- Page Specific Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('searchInput');
            const domainFilter = document.getElementById('domainFilter');
            const monthFilter = document.getElementById('monthFilter');
            const yearFilter = document.getElementById('yearFilter');
            const clearFilters = document.getElementById('clearFilters');
            const tableRows = document.querySelectorAll('#dataTableBody tr');

            function filterTable() {
                const term = searchInput.value.toLowerCase().trim();
                const domain = domainFilter.value;
                const month = monthFilter.value;
                const year = yearFilter.value;

                tableRows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    const d = row.dataset.domain || '';
                    const m = row.dataset.month || '';
                    const y = row.dataset.year || '';

                    const match = 
                        text.includes(term) &&
                        (!domain || d === domain) &&
                        (!month || m === month) &&
                        (!year || y === year);

                    row.style.display = match ? '' : 'none';
                });
            }

            if (searchInput) searchInput.addEventListener('input', filterTable);
            if (domainFilter) domainFilter.addEventListener('change', filterTable);
            if (monthFilter) monthFilter.addEventListener('change', filterTable);
            if (yearFilter) yearFilter.addEventListener('change', filterTable);

            if (clearFilters) {
                clearFilters.addEventListener('click', () => {
                    if (searchInput) searchInput.value = '';
                    if (domainFilter) domainFilter.value = '';
                    if (monthFilter) monthFilter.value = '';
                    if (yearFilter) yearFilter.value = '';
                    filterTable();
                });
            }

            // Delete confirmation
            window.handleDelete = function(e, form) {
                e.preventDefault();
                if (confirm('Bạn có chắc chắn muốn xóa chỉ số này? Hành động này không thể khôi phục.')) {
                    form.submit();
                }
                return false;
            };

            // CSV Export
            const exportBtn = document.getElementById('exportCsvBtn');
            if (exportBtn) {
                exportBtn.addEventListener('click', function() {
                    const visibleRows = Array.from(document.querySelectorAll('#dataTableBody tr'))
                                           .filter(row => row.style.display !== 'none');

                    if (!visibleRows.length) {
                        alert('Không có dữ liệu để xuất CSV');
                        return;
                    }

                    // Hiệu ứng loading
                    const originalHtml = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang xuất...';
                    this.disabled = true;

                    setTimeout(() => {
                        let csv = [];
                        // Header
                        csv.push(['Lĩnh vực', 'Chỉ số', 'Giá trị', 'Điểm', 'Cấp độ', 'Mô tả', 'Ngày cập nhật'].join(','));

                        visibleRows.forEach(row => {
                            const cols = row.querySelectorAll('td');
                            const rowData = [];
                            for (let i = 0; i < cols.length - 1; i++) { // Bỏ qua cột hành động
                                let text = cols[i].textContent.trim();
                                text = text.replace(/"/g, '""');
                                rowData.push(`"${text}"`);
                            }
                            csv.push(rowData.join(','));
                        });

                        const blob = new Blob([csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = `Climate_Smart_City_Data_${new Date().toISOString().slice(0,10)}.csv`;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        URL.revokeObjectURL(url);

                        this.innerHTML = originalHtml;
                        this.disabled = false;
                    }, 500);
                });
            }
        });
    </script>
</body>
</html>