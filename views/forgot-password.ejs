<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quên Mật Khẩu - Climate Smart City</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #3b82f6;
            --secondary: #8b5cf6;
            --success: #10b981;
            --danger: #ef4444;
            --dark: #0f172a;
            --light: #f8fafc;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        .main-container {
            width: 100%;
            max-width: 480px;
            padding: 20px;
        }

        .card {
            background: rgba(15, 23, 42, 0.78);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(59, 130, 246, 0.4);
            border-radius: 24px;
            padding: 45px 40px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
            animation: fadeInScale 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        @keyframes fadeInScale {
            from {
                opacity: 0;
                transform: scale(0.88) translateY(40px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .logo-title {
            text-align: center;
            margin-bottom: 35px;
        }

        .logo-title i {
            font-size: 3.5rem;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 14px;
            display: block;
        }

        .logo-title h2 {
            font-size: 2.25rem;
            font-weight: 900;
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 6px;
        }

        .form-label {
            color: #cbd5e1;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .form-control {
            background: rgba(30, 41, 59, 0.88);
            border: 1px solid rgba(59, 130, 246, 0.45);
            color: #f8fafc;
            border-radius: 14px;
            padding: 15px 20px;
            font-size: 1.03rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            background: rgba(30, 41, 59, 0.95);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.28);
            transform: translateY(-2px);
        }

        .form-control::placeholder {
            color: #94a3b8;
        }

        .btn-primary {
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            border: none;
            padding: 15px 32px;
            font-weight: 600;
            border-radius: 14px;
            width: 100%;
            font-size: 1.06rem;
            transition: all 0.35s ease;
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 40px rgba(59, 130, 246, 0.5);
        }

        .btn-outline-light {
            border: 2px solid rgba(248, 250, 252, 0.6);
            color: #f8fafc;
            border-radius: 14px;
            padding: 14px 32px;
            font-weight: 600;
            width: 100%;
            margin-top: 14px;
            transition: all 0.3s ease;
        }

        .btn-outline-light:hover {
            background: rgba(248, 250, 252, 0.1);
            border-color: #f8fafc;
            transform: translateY(-2px);
        }

        .alert {
            border-radius: 14px;
            padding: 16px 22px;
            font-weight: 500;
            border: none;
            margin-bottom: 24px;
        }

        @media (max-width: 576px) {
            .card {
                padding: 35px 25px;
                margin: 10px;
            }
            .logo-title h2 {
                font-size: 1.95rem;
            }
            .logo-title i {
                font-size: 3rem;
            }
        }
    </style>
</head>
<body>

    <div class="main-container">
        <div class="card">
            <!-- Header -->
            <div class="logo-title">
                <i class="fas fa-cloud-sun-rain"></i>
                <h2>Climate Smart City</h2>
                <p class="text-muted mt-2">TP. Hồ Chí Minh</p>
            </div>

            <h3 class="text-center mb-3"><i class="fas fa-key me-2"></i>Quên Mật Khẩu</h3>
            <p class="text-center text-muted mb-4" style="font-size: 1.02rem;">
                Nhập email của bạn để nhận liên kết đặt lại mật khẩu
            </p>

            <!-- Alerts -->
            <% if (error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i><%= error %>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            <% } %>

            <% if (success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i><%= success %>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            <% } %>

            <!-- Form -->
            <form method="POST" action="/forgot-password" class="needs-validation" novalidate>
                <div class="mb-4">
                    <label for="email" class="form-label">Địa chỉ Email</label>
                    <input type="email" 
                           class="form-control" 
                           id="email" 
                           name="email" 
                           placeholder="example@email.com" 
                           required>
                    <div class="invalid-feedback">
                        Vui lòng nhập email hợp lệ.
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <span class="spinner-border spinner-border-sm me-2 d-none" id="spinner" role="status"></span>
                    <i class="fas fa-paper-plane me-2"></i>Gửi Liên Kết Đặt Lại
                </button>

                <a href="/login" class="btn btn-outline-light">
                    <i class="fas fa-arrow-left me-2"></i>Quay lại Đăng Nhập
                </a>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Form validation
        (function () {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();

        // Loading effect khi submit
        document.querySelector('form').addEventListener('submit', function() {
            const btn = document.getElementById('submitBtn');
            const spinner = document.getElementById('spinner');
            btn.disabled = true;
            spinner.classList.remove('d-none');
        });
    </script>
</body>
</html>